#!/usr/bin/env node
// Deterministic, model-free scaffold for adopting the workflow in a project: procedures/setup.md step 3.
// Every shared file is read from the pinned workflow revision, never from a working tree. Existing files
// are never overwritten. The script grants nothing: owner steps stay the owner's and are written as a
// checklist into docs/workflow/setup.md.
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { spawnSync } from 'node:child_process';
import { fileURLToPath, pathToFileURL } from 'node:url';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const OPTIONS = ['project', 'repository', 'rev', 'coordinator', 'workflow-repo', 'workflow-slug', 'production', 'lane', 'owner', 'planning-frontend', 'speckit-python', 'approval', 'worker'];
const USAGE = `usage: wf-adopt --project DIR --repository OWNER/REPOSITORY --rev TAG_OR_FULL_HASH --coordinator NAME
  [--approval manual|owner-merge] [--worker NAME] [--client-page]
  [--workflow-repo DIR] [--workflow-slug OWNER/REPO] [--production GLOB]... [--lane new|existing] [--owner NAME]... [--json]
  [--planning-frontend speckit --speckit-python /absolute/isolated/venv/bin/python]
       wf-adopt --inspect --project DIR [--workflow-repo DIR] [--rev TAG_OR_FULL_HASH] [--production GLOB]... [--json]
  --inspect reports on a repository without changing it: existing adoption, Git state, tracked manifests and CI jobs
  (untrusted hints, never run), suggested production globs, unclassified tracked paths and collisions. It grants nothing.
  Spec Kit is experimental and opt-in; use an authorised non-production pilot until certified release/adoption.
  --owner, given once for each person (two or more), sets up a shared project: the profile's owners and their setup steps.
  --approval: manual (the default: the owner signs receipts) or owner-merge (the owner's own merge of each pull request
  is the approval; fastest, and nothing proves who merged). Enforced is never scaffolded: the switch to it is a
  code-owner-reviewed pull request once the protections are verified (procedures/setup.md, steps 5 and 9).
  --worker: the agent's own GitHub account, when it has one; without it the agent works with the owner's account.
  --client-page: also install .github/workflows/wf-client-page.yml, which publishes the plain-language client page
  (wf status --client) to GitHub Pages. A Pages site is public, even for a private repository.
  Writes docs/workflow/config.json (full-hash pin), the record directories, profile/setup/acceptance seeds,
  scripts/wf, AGENTS.md, CLAUDE.md, .github/CODEOWNERS and .github/workflows/wf-{ci,status}.yml when absent, fetches the pinned installation into .cache/agent-workflow/
  and writes the owner checklist. Never overwrites; refuses a second adoption. Exit 0 done, 2 refused/invalid.`;

const fail = (message, code = 2) => { console.error(`wf-adopt: ${message}`); process.exit(code); };

function parse(argv) {
  const o = { production: [], owner: [], lane: 'new', given: new Set() };
  const seen = new Set();
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--json') { o.json = true; continue; }
    if (a === '--inspect') { o.inspect = true; continue; }
    if (a === '--client-page') { o.clientPage = true; continue; }
    if (a === '--help' || a === '-h') { console.log(USAGE); process.exit(0); }
    if (!a.startsWith('--')) fail(`unexpected argument: ${a}\n${USAGE}`);
    const name = a.slice(2);
    const value = argv[i + 1];
    if (!OPTIONS.includes(name) || value == null || value.startsWith('--')) fail(`invalid option or missing value: ${a}\n${USAGE}`);
    i++;
    o.given.add(name);
    if (name === 'production' || name === 'owner') o[name].push(value);
    else if (seen.has(name)) fail(`duplicate option: ${a}`);
    else { seen.add(name); o[name] = value; }
  }
  return o;
}

function git(repo, args, { allowFailure = false } = {}) {
  const r = spawnSync('git', ['-C', repo, ...args], { encoding: 'utf8', timeout: 120000, maxBuffer: 16 * 1024 * 1024 });
  if (r.status !== 0 && !allowFailure) fail(`git ${args[0]} failed: ${(r.stderr || r.error?.message || '').trim()}`);
  return r;
}

const o = parse(process.argv.slice(2));
// Read-only inspection: its own small set of options, and nothing below (no writes, no clone) runs.
if (o.inspect) {
  const unused = [...o.given].filter(k => !['project', 'workflow-repo', 'rev', 'production'].includes(k));
  if (unused.length) fail(`--inspect does not take ${unused.map(k => `--${k}`).join(', ')}\n${USAGE}`);
  if (!o.project) fail(`--project is required\n${USAGE}`);
  const { inspectProject, renderText } = await import(new URL('../adapters/inspect.mjs', import.meta.url).href);
  let report;
  try { report = await inspectProject({ project: path.resolve(o.project), workflowRepo: path.resolve(o['workflow-repo'] ?? path.join(HERE, '..')), rev: o.rev ?? 'HEAD', production: o.production }); }
  catch (error) { fail(error.message); }
  // Wait for the write: exiting at once would cut a piped report short.
  await new Promise(resolve => process.stdout.write(`${o.json ? JSON.stringify(report, null, 2) : renderText(report)}\n`, resolve));
  process.exit(0);
}
for (const k of ['project', 'repository', 'rev', 'coordinator']) if (!o[k]) fail(`--${k} is required\n${USAGE}`);
if (!/^[\w.-]+\/[\w.-]+$/.test(o.repository)) fail('--repository must be OWNER/REPOSITORY');
if (!['new', 'existing'].includes(o.lane)) fail('--lane must be new or existing');
if (o.owner.length === 1) fail('--owner is for a shared project: give it once for each person, two or more');
const USERNAME = /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$/;
for (const name of o.owner) if (!USERNAME.test(name)) fail(`--owner ${name} is not a GitHub username`);
if (new Set(o.owner).size !== o.owner.length) fail('--owner names a person twice');
const shared = o.owner.length >= 2;
const approval = o.approval ?? 'manual';
if (!['manual', 'owner-merge'].includes(approval)) fail(`--approval must be manual or owner-merge; enforced follows verified protections (procedures/setup.md step 9)`);
if (o.worker !== undefined && !USERNAME.test(o.worker)) fail(`--worker ${o.worker} is not a GitHub username`);
if (o.worker && shared) fail('--worker is for one owner; in a shared project each person verifies their own worker (procedures/shared.md)');
if (approval === 'owner-merge' && shared) fail('--approval owner-merge is for one owner: with several, whose merge counts is undefined; a shared project uses manual or enforced mode (procedures/shared.md)');
if (o.worker && o.worker.toLowerCase() === o.coordinator?.toLowerCase()) fail('--worker must be an account other than the owner\'s; omit it to work with one account');
// One account: the agent publishes with the owner's account. A shared project's people each have their own worker.
const oneAccount = !shared && !o.worker;
// The owner's GitHub username, when --coordinator is one: it fills approval.approver and CODEOWNERS.
const ownerLogin = !shared && USERNAME.test(o.coordinator ?? '') ? o.coordinator : null;
if (o['planning-frontend'] && o['planning-frontend'] !== 'speckit') fail('unsupported --planning-frontend');
if (Boolean(o['planning-frontend']) !== Boolean(o['speckit-python'])) fail('--planning-frontend speckit requires --speckit-python, and vice versa');
if (o['planning-frontend'] && shared) fail('the experimental Spec Kit adapter supports one owner only');
if (o['speckit-python'] && !path.isAbsolute(o['speckit-python'])) fail('--speckit-python must be an absolute isolated Python executable');
const workflowRepo = path.resolve(o['workflow-repo'] ?? path.join(HERE, '..'));
const project = path.resolve(o.project);
if (!fs.existsSync(project) || !fs.statSync(project).isDirectory()) fail(`project directory not found: ${project}`);
if (fs.existsSync(path.join(project, 'docs/workflow/config.json'))) fail('docs/workflow/config.json already exists: this project is adopted; changing its pin is a deliberate edit of that file, not a re-scaffold');

// Resolve the pin to an immutable full hash. A commit that carries a tag is recorded under that tag;
// anything else is UNRELEASED, because only released tags are meant to be adopted.
const resolved = git(workflowRepo, ['rev-parse', '--verify', '--end-of-options', `${o.rev}^{commit}`], { allowFailure: true });
if (resolved.status !== 0) fail(`--rev ${o.rev} does not resolve to a commit in ${workflowRepo}`);
const revision = resolved.stdout.trim();
if (!/^[0-9a-f]{40}$|^[0-9a-f]{64}$/.test(revision)) fail('the pin must be a full commit hash');
const exactTag = git(workflowRepo, ['describe', '--tags', '--exact-match', revision], { allowFailure: true });
const version = exactTag.status === 0 ? exactTag.stdout.trim() : 'UNRELEASED';
const show = rel => {
  const r = git(workflowRepo, ['show', `${revision}:${rel}`], { allowFailure: true });
  if (r.status !== 0) fail(`${rel} is not present at ${revision}: this scaffold needs a workflow revision that contains it (releases after v1.0.0); a v1.0.0 adoption follows that version's own QUICKSTART`);
  return r.stdout;
};
// Read every pinned file before the first write, so a revision that lacks one leaves nothing behind.
const optional = rel => { const r = git(workflowRepo, ['show', `${revision}:${rel}`], { allowFailure: true }); return r.status === 0 ? r.stdout : null; };
const pinned = { config: show('config.default.json'), profile: show('templates/profile.md'), setup: show('templates/setup.md'), reviewer: optional('templates/claude/agents/independent-reviewer.md'), status: optional('templates/github/wf-status.yml'), ci: optional('templates/github/wf-ci.yml'), compact: optional('templates/claude/compact-instructions.md'), clientPage: optional('templates/github/wf-client-page.yml') };
if (o.clientPage && pinned.clientPage === null) fail(`the workflow revision ${revision} has no client page; pin a later release or omit --client-page`);
if (shared && !/^owners:/m.test(pinned.profile)) fail(`the workflow revision ${revision} has no shared-project support (its profile template lacks owners); pin a later release or omit --owner`);

const created = [], appended = [], skipped = [];
const write = (rel, content, mode) => {
  const target = path.join(project, rel);
  if (fs.existsSync(target)) { skipped.push(rel); return false; }
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content, mode ? { mode } : undefined);
  created.push(rel);
  return true;
};
const ensureDir = rel => {
  const dir = path.join(project, rel);
  if (fs.existsSync(dir)) { skipped.push(`${rel}/`); return; }
  fs.mkdirSync(dir, { recursive: true });
  fs.writeFileSync(path.join(dir, '.gitkeep'), '');
  created.push(`${rel}/`);
};
const setLine = (text, key, value) => {
  const re = new RegExp(`^${key}:.*$`, 'm');
  if (!re.test(text)) fail(`template lacks a ${key} line`);
  return text.replace(re, `${key}: ${value}`);
};

// Config: the defaults at the pinned revision, plus the pin, the project identity and the stack's extra
// production patterns. Approval identities stay empty until the owner's identity step fills them.
const config = JSON.parse(pinned.config);
const trusted = config.trusted_branch ?? 'main';
if (!/^[\w./-]+$/.test(trusted)) fail(`trusted_branch ${JSON.stringify(trusted)} is not a plain branch name`);
const slug = o['workflow-slug'] ?? config.workflow?.repo ?? 'Cazy00/agent-workflow';
config.workflow = { repo: slug, version, revision };
config.repository = o.repository;
// Never an enforced label from a scaffold: that switch is the reviewed pull request after steps 5 and 9.
const mechanism = approval === 'owner-merge' ? 'owner-merge' : 'manual-signed-receipts';
config.approval = { ...(config.approval ?? {}), mechanism, label: approval, approver: ownerLogin ?? config.approval?.approver ?? '', agent_identity: o.worker ?? '' };
config.paths ??= {};
config.paths.production ??= [];
for (const g of o.production) if (!config.paths.production.includes(g)) config.paths.production.push(g);

// Records: profile, setup record, empty acceptance definitions and mappings, record directories, inbox.
const name = o.repository.split('/')[1];
let profile = pinned.profile;
profile = setLine(profile, 'project', name);
profile = setLine(profile, 'workflow_version', version);
profile = setLine(profile, 'coordinator', o.coordinator);
profile = setLine(profile, 'approval_mechanism', mechanism);
profile = setLine(profile, 'approval_label', approval);
if (shared) profile = setLine(profile, 'owners', `[${o.owner.join(', ')}]`);

// Optional staging executes only the exact pinned adapter in an isolated clone.
// Complete inventory/runtime/collision checks precede the first project write.
let speckit = null, scaffoldStarted = false, scaffoldComplete = false;
if (o['planning-frontend']) {
  if (optional('adapters/speckit/scaffold.mjs') === null) fail('the pinned workflow has no Spec Kit scaffold support');
  const temporary = fs.mkdtempSync(path.join(os.tmpdir(), 'wf-adopt-speckit-'));
  process.on('exit', () => {
    if (!scaffoldStarted || scaffoldComplete) fs.rmSync(temporary, {recursive:true,force:true});
    else console.error(`wf-adopt: interrupted scaffold; inspect the preserved stage at ${path.join(temporary,'stage')} before create-only recovery`);
  });
  try {
    const checkout = path.join(temporary,'workflow');
    git(workflowRepo, ['clone','--quiet','--no-hardlinks',workflowRepo,checkout]);
    git(checkout, ['checkout','--quiet','--detach',revision]);
    const adapter = await import(pathToFileURL(path.join(checkout,'adapters/speckit/scaffold.mjs')).href);
    speckit = adapter.prepareScaffold({project, directory:path.join(temporary,'stage'), python:o['speckit-python'], coreRevision:revision, profileText:profile});
    config.planning_frontend = {name:'speckit',compatibility_api:1,feature_root:'docs/specs'};
  } catch(error) { fail(`Spec Kit staging refused: ${error.message}`); }
}
scaffoldStarted = true;
write('docs/workflow/config.json', JSON.stringify(config, null, 2) + '\n');
write('docs/workflow/profile.md', profile);

const today = new Date().toISOString().slice(0, 10);
// The owner's checklist follows the arrangement chosen here: one account or a worker, and the approval mode. Each
// GitHub step is optional where the mode does not depend on it, and scripted where it does (bin/wf-protect).
const protect = 'node .cache/agent-workflow/bin/wf-protect --project .';
const arrangement = shared
  ? `Arrangement: shared by ${o.owner.join(', ')}, each with their own worker account (\`procedures/shared.md\`). Approval: \`${approval}\`.`
  : oneAccount
    ? `Arrangement: one GitHub account${ownerLogin ? ` (\`${ownerLogin}\`)` : ''}. The agent works with it, so GitHub cannot tell the agent's actions from yours; the agent records this in the profile's *Authority* as an approved deviation. A worker account can be added later (\`identity.md\`); enforced mode needs one, because GitHub never lets you approve your own pull request. Approval: \`${approval}\`.`
    : `Arrangement: owner \`${o.coordinator}\`, worker \`${o.worker}\` (filled in \`approval.approver\` and \`approval.agent_identity\`). Approval: \`${approval}\`.`;
const ruleset = shared
  ? 'pull requests with code-owner review and approval of the most recent push'
  : approval === 'manual'
    ? 'only that the trusted branch is never deleted or rewritten, since your receipts carry approval and your closeout fast-forward must still push'
    : 'pull requests, with the `wf ci` check and each of the profile\'s `required_checks` passing from GitHub Actions on an up-to-date branch';
const approvalStep = approval === 'owner-merge'
  ? '- [ ] 6. Nothing to provision: your own review and merge of each pull request is the approval, and `.github/workflows/wf-ci.yml` runs the pinned validator as the `wf ci` check. Merge only what you have reviewed, and never let the agent merge: nothing in this mode proves who merged (`approval-evidence.md`, *Owner-merge mode*). The setup record states this limit.\n'
  : `- [ ] 6. Your signing key, outside every checkout: \`node .cache/agent-workflow/bin/wf-sign --keygen DIR\` asks for a passphrase, which keeps the key from the agent${oneAccount ? ' (it runs as you, so it can read your files)' : ''}; you sign each round with \`wf-sign\` (\`approval-evidence.md\`). Install the launcher for your own runs outside the agent clone, pinned to \`${revision}\` (\`WF_VALIDATOR_REPO\`, \`WF_VALIDATOR_REV\`). Nothing is approved until you sign.\n`;
const enforcedStep = oneAccount
  ? ''
  : `- [ ] 9. Optional, to switch to enforced mode, where the protections rather than your signature or your own merge carry approval: \`${protect} --target enforced --apply\`, then \`${protect} --target enforced\` must pass; then switch \`approval.label\` (config) and \`approval_label\` (profile) to \`enforced\` in one code-owner-reviewed pull request. The live approval-path test in a disposable repository (\`setup.md\` step 9) is stronger evidence and optional${shared ? ', except that it must show a worker\'s approval cannot merge' : ''}\n`;
const checklist = `
## Owner steps (procedures/setup.md; the agent does not attempt, retry or wait on these)

${arrangement}

${oneAccount ? '' : `- [ ] 2. Verify the owner and worker GitHub usernames; give the worker write access; separate human and agent clones; follow \`identity.md\`\n`}${shared ? `- [ ] Shared project (\`procedures/shared.md\`): the repository owner gives the other people and every worker account write access; \`CODEOWNERS\` assigns every path (\`*\`) to ${o.owner.join(', ')} and no worker, and the ruleset requires code-owner review and approval of the most recent push; each person verifies their own worker username, keeps their own agent clone and token, and runs the identity check and step 8 with their own tools; step 9 also shows that a worker's approval cannot merge; the profile's *Authority* records who approves what, and who approves when one of you is away\n` : ''}- [ ] 5. Optional, and only on a public repository or a GitHub Pro or Team plan: protections. Once the scaffold is on the trusted branch, run \`${protect} --apply\` with your own \`gh\` login; it creates one ruleset requiring ${ruleset}, with no bypass${!shared && !oneAccount && approval !== 'manual' ? ' (enforced mode later adds code-owner review and auto-merge: step 9)' : ''}. \`${protect}\` reads the settings back.${approval === 'manual' && !shared ? '' : ' Rerun \`--apply\` after approving a change to \`required_checks\`.'} Without rulesets, skip this and say so here
${approvalStep}${enforcedStep}${o.clientPage ? `- [ ] Optional: turn on GitHub Pages with GitHub Actions as the source (Settings, Pages, or \`gh api -X POST repos/${o.repository}/pages -f build_type=workflow\`) so \`.github/workflows/wf-client-page.yml\` publishes the client page. The page is public, even for a private repository; leave stages out with \`client.exclude\` in \`docs/workflow/config.json\`
` : ''}${pinned.status !== null ? '- [ ] Optional: pin the *Project status* issue once `.github/workflows/wf-status.yml` has opened it on the trusted branch (or run that workflow from the Actions tab); delete the file to opt out\n' : ''}- [ ] 11. Your first milestone is the pilot: watch it (\`templates/pilot.md\`)

## Agent steps (one session at a time; post progress here and stop)

- [ ] 1. Fill \`docs/workflow/profile.md\` from the owner's input and \`docs/workflow/inbox/\`; leave *Unknowns* honest, each with its required-before stage
- [ ] 4. Add the stack-specific path classifications the defaults miss (\`docs/workflow/config.json\`)
- [ ] 7. The profile's \`required_checks\` (readiness fails while it is empty); acceptance IDs and mappings for the first milestone only
- [ ] 8. Fixtures and tool-discovery tests, in their own session
${o.lane === 'existing' ? '\nExisting repository: do not inventory the codebase; classification is a config edit; keep the first milestone small enough to be the pilot; porting into a fresh repository is an owner option to record here.\n' : ''}
Read for setup: \`procedures/setup.md\`, \`identity.md\`, \`templates/profile.md\`, \`templates/setup.md\` and \`config.default.json\` in \`.cache/agent-workflow/\`. Consult \`POLICY.md\` and \`SCHEMA.md\` only when a rule is unclear.
`;
let setup = pinned.setup.replace('SETUP-0000', 'SETUP-0001');
setup = setup.replace('Profile, repository, workflow tag and immutable revision:', `Profile, repository, workflow tag and immutable revision: docs/workflow/profile.md · ${o.repository} · ${version} · ${revision}`);
setup = setup.replace('usage per step:', `usage per step: scaffolded ${today}; lane ${o.lane}; ${shared ? 'shared' : oneAccount ? 'one account' : 'owner and worker accounts'}; approval ${approval}; usage per step recorded below`);
if (approval === 'owner-merge') setup = setup.replace('Execution mode: assisted.', "Execution mode: assisted. Approval: owner-merge, chosen by the owner: the owner's own merge of each pull request is the approval. No protection shows that the owner, not the agent, merged, and agent-operated routine integration is unavailable; switching to enforced (setup step 9) or manual removes this limit.");
write('docs/workflow/setup.md', setup + checklist);

write('docs/workflow/acceptance.json', JSON.stringify({ examples: [] }, null, 2) + '\n');
write('tests/acceptance-map.json', '[]\n');
for (const d of ['docs/workflow/milestones', 'docs/workflow/tasks', 'docs/workflow/decisions', 'docs/workflow/feedback/inbox', 'docs/workflow/inbox/done']) ensureDir(d);
write('docs/workflow/inbox/README.md', `# Inbox

Drop raw input for the agent here: notes, transcripts, screenshots, links, requirement fragments. Items carry no authority. The agent triages each one at discovery into the profile, a spec, a decision, a milestone or a task, records where it went, and moves it to \`done/\`. A note that resolves a reserved decision is the request, not the approval. See \`procedures/readiness.md\` in the workflow installation.
`);

// Local convenience launcher, adapters and the ignored installation cache.
const WF = [
  '#!/usr/bin/env bash',
  '# Local convenience launcher: runs the workflow validator at the revision pinned in docs/workflow/config.json.',
  '# Feedback only. Authoritative gates use the owner-installed launcher outside this checkout (procedures/setup.md step 6).',
  'set -euo pipefail',
  'ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"',
  'CONFIG="$ROOT/docs/workflow/config.json"',
  '[ -f "$CONFIG" ] || { echo "wf: $CONFIG not found" >&2; exit 2; }',
  'read -r REPO REV < <(node -e \'',
  '  const c = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).workflow;',
  '  if (!c.repo || !/^[0-9a-f]{40}$|^[0-9a-f]{64}$/.test(c.revision)) { console.error("wf: workflow.repo and a full workflow.revision must be set"); process.exit(2); }',
  '  console.log(c.repo, c.revision)\' "$CONFIG")',
  'CACHE="$ROOT/.cache/agent-workflow"',
  '[ -d "$CACHE/.git" ] || git clone --quiet "https://github.com/$REPO.git" "$CACHE"',
  'if [ "$(git -C "$CACHE" rev-parse HEAD)" != "$REV" ]; then',
  '  git -C "$CACHE" fetch --quiet origin && git -C "$CACHE" checkout --quiet --detach "$REV"',
  'fi',
  '[ "$(git -C "$CACHE" rev-parse HEAD)" = "$REV" ] || { echo "wf: installation is not at the pinned revision $REV" >&2; exit 2; }',
  'exec node "$CACHE/validator/cli.js" --repo "$ROOT" "$@"',
  '',
].join('\n');
write('scripts/wf', WF, 0o755);

const gitignore = path.join(project, '.gitignore');
const ignored = fs.existsSync(gitignore) ? fs.readFileSync(gitignore, 'utf8') : null;
if (!(ignored ?? '').split(/\r?\n/).some(l => ['.cache/', '.cache'].includes(l.trim()))) {
  fs.writeFileSync(gitignore, (ignored ?? '') + (ignored && !ignored.endsWith('\n') ? '\n' : '') + '.cache/\n');
  (ignored == null ? created : appended).push('.gitignore');
}
if (speckit) {
  fs.appendFileSync(gitignore, speckit.ignoreRules);
  if (!created.includes('.gitignore') && !appended.includes('.gitignore')) appended.push('.gitignore');
  const installed = speckit.apply();
  created.push(...installed.created);
}

write('AGENTS.md', `# ${name} — agent guide

Read this first; it is a map. The workflow that governs work here is \`${slug}\` at the revision pinned in \`docs/workflow/config.json\`, installed at \`.cache/agent-workflow/\` (\`scripts/wf records\` fetches it when missing). Start every session with \`scripts/wf next\`: it names the next action, what to read for it and what to run. Read that and nothing else unless it points further; the installation's \`.agents/skills/workflow/SKILL.md\` maps the procedures.

| Need | Go to |
|---|---|
| What the project is, who decides what, quality bar, delivery | \`docs/workflow/profile.md\` |
| Milestones, tasks, decisions | \`docs/workflow/milestones/\`, \`docs/workflow/tasks/\`, \`docs/workflow/decisions/\`; only records on the approved baseline count |
| Raw owner input awaiting triage (no authority) | \`docs/workflow/inbox/\` |
| Acceptance definitions and test mappings | \`docs/workflow/acceptance.json\`, \`tests/acceptance-map.json\` |
| Setup progress, owner checklist and agent steps | \`docs/workflow/setup.md\` |
| Progress at a glance (derived; never edit it) | ${pinned.status !== null ? 'the pinned *Project status* issue on GitHub, or ' : ''}\`scripts/wf status\` |
| Procedures, templates, policy | \`.cache/agent-workflow/procedures/\`, \`templates/\`, \`POLICY.md\` |

Commands: \`scripts/wf next | records | readiness | paths | ci | acceptance | lifecycle | session | status | brief | closeout\`, and \`attest\` for the owner (usage in the installation's \`QUICKSTART.md\`). Run evidence, reviews and handoffs go on the task's pull request or issue (without either, in manual mode, beside the signing round in the signing drop), never into this repository. In manual mode the trusted branch moves only by the fast-forward \`wf closeout\` prints once it passes on the owner's signed receipts, which the session after signing runs. One pull request per task, never per step. ${shared ? 'Never' : approval === 'owner-merge' ? 'The approval mode is owner-merge: the owner\'s own merge of the pull request is the approval, so never turn on auto-merge, and never' : 'Never turn on auto-merge (it could merge before the owner signs), and never'} approve, ${shared ? 'merge by hand' : 'merge'}, sign or bypass a rule yourself; ${oneAccount ? 'you work with the owner\'s own GitHub account, so GitHub will let you do these things: the rule is yours to keep.' : 'never switch to the owner\'s account.'}
${shared ? `\nSeveral people share the owner role (\`owners\` in the profile): work only on tasks whose \`owner\` is the person you work for, and claim each one before starting (\`procedures/shared.md\`). Never use another person's worker account.\n` : ''}`);
write('CLAUDE.md', `# Shared repository instructions

Read \`AGENTS.md\`, then \`.cache/agent-workflow/.agents/skills/workflow/SKILL.md\` and the relevant procedure it identifies. They are the shared workflow for this repository. Tool-specific defaults do not grant additional authority. Check the current baseline and task records before continuing.
${pinned.compact !== null ? `\n${pinned.compact}` : ''}`);

// Claude Code's independent-reviewer subagent: the separate review context of procedures/review.md.
if (pinned.reviewer !== null) write('.claude/agents/independent-reviewer.md', pinned.reviewer);
else skipped.push('.claude/agents/independent-reviewer.md (not in this workflow revision)');

// Who must approve which paths (setup step 5). GitHub enforces it only when a ruleset requires code-owner review; it is
// written here so the owner never has to. One owner: every path, except task and feedback records, which then merge
// after their checks alone. A shared project: every path, to all of its people.
const OWNERSHIP = ['CODEOWNERS', '.github/CODEOWNERS', 'docs/CODEOWNERS'];
const present = OWNERSHIP.find(rel => fs.existsSync(path.join(project, rel)));
const rd = config.records_dir ?? 'docs/workflow';
if (present) skipped.push(`.github/CODEOWNERS (${present} exists: check it against procedures/setup.md step 5)`);
else if (shared || ownerLogin) write('.github/CODEOWNERS', `# Who must approve which changes (procedures/setup.md step 5). GitHub enforces this only when a ruleset requires
# code-owner review (bin/wf-protect). Written by bin/wf-adopt; a change to it is a workflow change.
* ${(shared ? o.owner : [ownerLogin]).map(n => `@${n}`).join(' ')}
${shared ? '' : `# Task and feedback records name no owner, so they merge after their checks alone.
/${rd}/tasks/
/${rd}/feedback/
`}`);
else skipped.push('.github/CODEOWNERS (--coordinator is not a GitHub username)');

// The `wf ci` check: the pinned validator, from the base branch's pin, on every pull request.
if (pinned.ci !== null) write('.github/workflows/wf-ci.yml', pinned.ci);
else skipped.push('.github/workflows/wf-ci.yml (not in this workflow revision)');

// The client page on GitHub Pages, only on request: it is public wherever Pages is.
if (o.clientPage) write('.github/workflows/wf-client-page.yml', pinned.clientPage.replaceAll('__TRUSTED_BRANCH__', trusted));

// The owner's status view on GitHub: republishes `wf status` to a pinned issue from the trusted branch.
if (pinned.status !== null) write('.github/workflows/wf-status.yml', pinned.status.replaceAll('__TRUSTED_BRANCH__', trusted));
else skipped.push('.github/workflows/wf-status.yml (not in this workflow revision)');

const cache = path.join(project, '.cache/agent-workflow');
if (fs.existsSync(cache)) skipped.push('.cache/agent-workflow/');
else {
  fs.mkdirSync(path.dirname(cache), { recursive: true });
  const clone = spawnSync('git', ['clone', '--quiet', '--no-hardlinks', workflowRepo, cache], { encoding: 'utf8' });
  if (clone.status !== 0) fail(`could not clone the workflow installation: ${(clone.stderr || '').trim()}`);
  git(cache, ['checkout', '--quiet', '--detach', revision]);
  git(cache, ['remote', 'set-url', 'origin', `https://github.com/${slug}.git`]);
  created.push('.cache/agent-workflow/ (ignored by Git)');
}

const result = { ok: true, project, repository: o.repository, workflow: config.workflow, revision, version, lane: o.lane, owners: o.owner, created, appended, skipped };
if (speckit) result.planning_frontend = {name:'speckit',certified:false,integration:'codex',pilot_required:true};
scaffoldComplete = true;
if (o.json) console.log(JSON.stringify(result, null, 2));
else {
  console.log(`Adopted ${slug} ${version} (${revision}) in ${project} for ${o.repository}.`);
  if (created.length) console.log(`\nCreated:\n  ${created.join('\n  ')}`);
  if (appended.length) console.log(`\nAppended:\n  ${appended.join('\n  ')}`);
  if (skipped.length) console.log(`\nLeft as they were (already present):\n  ${skipped.join('\n  ')}`);
  if (skipped.some(s => s === 'AGENTS.md' || s === 'CLAUDE.md')) console.log(`\nAn adapter already existed: add a pointer to .cache/agent-workflow/.agents/skills/workflow/SKILL.md and docs/workflow/ to it yourself${skipped.includes('CLAUDE.md') ? ', and copy .cache/agent-workflow/templates/claude/compact-instructions.md into CLAUDE.md' : ''}.`);
  if (version === 'UNRELEASED') console.log('\nNote: the pin is not a released tag; recorded as UNRELEASED.');
  console.log('\nNext: commit the scaffold to the trusted branch, then read docs/workflow/setup.md. It holds the owner steps and the agent steps.');
  console.log(checklist);
}
