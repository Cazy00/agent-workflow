#!/usr/bin/env bash
# runner-setup OWNER/REPO LABEL, as root inside a CI container, with the registration token on stdin: download the
# current GitHub Actions runner, check it against the checksum its release publishes, register it for the
# repository under LABEL as the `runner` user, and run it as a service. In a build container (one with
# /opt/ci-hooks/clean-docker.sh) it clears Docker after every job. Pushed and run by the host's ci-runner.
set -euo pipefail
repo="$1"
label="$2"
read -r token
dir=/home/runner/actions-runner
# No apt activity in a job (I-121's second cause; ci-pool-image says why, and why the mask). Runs on every registration, so an
# existing runner is covered too. Best effort, as for rsyslog below: each failed step is said on stderr and the setup goes on.
# An apt run in progress is not stopped, which can take 15 minutes: the mask stops the next one and the purges wait for its lock.
systemctl disable --now apt-daily.timer apt-daily-upgrade.timer ||
  echo "runner-setup: could not disable the apt timers (exit $?); registering anyway" >&2
systemctl mask apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service \
  packagekit.service packagekit-offline-update.service ||
  echo "runner-setup: could not mask the apt units (exit $?); registering anyway" >&2
for pkg in needrestart unattended-upgrades; do  # needrestart first, so the second purge does not run its hook
  if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then
    DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 purge -y "$pkg" ||
      echo "runner-setup: could not purge $pkg (exit $?); registering anyway" >&2
  fi
done
# No rsyslog: nothing in a CI job reads /var/log/syslog (containers log to journald), and the image's rsyslogd AppArmor profile
# denies journald's send to /run/systemd/journal/dev-log, about 6,700 denials a day on the host (I-104). Runs on every
# registration, so an existing runner loses it too. Best effort: a held dpkg lock or a broken apt must not stop a
# registration, so a failed purge is said on stderr and the setup goes on; a runner without rsyslog skips apt.
if dpkg-query -W -f='${Status}' rsyslog 2>/dev/null | grep -q 'install ok installed'; then
  DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 purge -y rsyslog ||
    echo "runner-setup: could not purge rsyslog (exit $?); registering anyway" >&2
fi
if [ -f "$dir/.runner" ]; then
  echo "$(hostname): already registered."
else
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
    *) echo "unsupported machine: $(uname -m)" >&2; exit 1 ;;
  esac
  release="$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest)"
  version="$(jq -r .tag_name <<<"$release")"
  version="${version#v}"
  sha="$(jq -r .body <<<"$release" | sed -n "s/.*<!-- BEGIN SHA linux-${arch} -->\([0-9a-f]\{64\}\)<!-- END SHA linux-${arch} -->.*/\1/p" | head -n1)"
  [ -n "$sha" ] || { echo "The runner release publishes no linux-${arch} checksum; stopping." >&2; exit 1; }
  curl -fsSL -o /tmp/runner.tar.gz "https://github.com/actions/runner/releases/download/v${version}/actions-runner-linux-${arch}-${version}.tar.gz"
  echo "${sha}  /tmp/runner.tar.gz" | sha256sum -c -
  install -d -o runner -g runner "$dir"
  sudo -u runner tar xzf /tmp/runner.tar.gz -C "$dir"
  rm /tmp/runner.tar.gz
  cd "$dir"
  ./bin/installdependencies.sh >/dev/null
  sudo -u runner -H ./config.sh --unattended --replace --url "https://github.com/${repo}" --token "$token" \
    --name "$(hostname)" --labels "$label" --no-default-labels --work _work
  if [ -x /opt/ci-hooks/clean-docker.sh ]; then
    echo "ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/opt/ci-hooks/clean-docker.sh" >> .env
  fi
fi
cd "$dir"
[ -f .service ] || ./svc.sh install runner
./svc.sh start
