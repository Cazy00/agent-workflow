#!/usr/bin/env bash
# ci-pool-image build LABEL: build the image a pool label starts its containers from (wf-build or wf-gate; "build" and
# "gate" work too), as root on the host. Ubuntu 24.04, the GitHub Actions runner (checked against the checksum its release
# publishes, as runner-setup does), git, gh and Node; for build also Docker, Playwright's browsers and postgres:18.6 already
# pulled, and /tmp as tmpfs. The runner is not registered: ci-pool-entrypoint registers it with a just-in-time config when
# a container starts, and the job-started check written here (/opt/ci-hooks/job-started.sh) refuses a job a trusted account
# did not start, or a pull request from another repository, before any of its steps runs. The image keeps its alias (ci-pool-build, ci-pool-gate); the one it replaces is kept as ALIAS-prev,
# and the one before that is deleted.
# Nothing here runs this on a schedule: a host rebuilds on release, and a weekly timer, if it wants one, is its own to add.
# A container takes no updates of its own (no apt timers), so its packages are as new as this build, which ends in a full
# upgrade. ci-pool replaces a spare made from an older image by itself.
set -euo pipefail
LXC="${LXC:-/snap/bin/lxc}"
SHARE="${SHARE:-/usr/local/share/ci-runner}"
NODE_MAJOR="${NODE_MAJOR:-22}"
POSTGRES_IMAGE="${POSTGRES_IMAGE:-postgres:18.6}"
TMP_SIZE="${TMP_SIZE:-2G}"
# The accounts whose runs a pool container runs (the job-started check below), compared ignoring case. They must be the
# JIT source's trusted accounts; the default is home's, the accounts its broker's repo_shared check trusts (the owner, the
# agent and the executor App's bot). A host whose accounts differ sets TRUSTED_ACTORS when it builds, or the check refuses
# every job.
TRUSTED_ACTORS="${TRUSTED_ACTORS:-Cazy00 MontaDev-sys workspace-executor-2eaa[bot]}"
[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

usage() { sed -n '2,3p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

[[ $# -eq 2 && "$1" == build ]] || usage
case "$2" in
  wf-build | build) kind=build ;;
  wf-gate | gate) kind=gate ;;
  *) usage ;;
esac
read -ra actors <<<"$TRUSTED_ACTORS"
[[ ${#actors[@]} -gt 0 ]] || { echo "ci-pool-image: TRUSTED_ACTORS names no account" >&2; exit 2; }
for actor in "${actors[@]}"; do
  [[ "$actor" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\[bot\])?$ ]] \
    || { echo "ci-pool-image: TRUSTED_ACTORS: not a GitHub login: $actor" >&2; exit 2; }
done
alias="ci-pool-$kind"
work="ci-pool-image-$kind-$$"
trap 'rc=$?; echo "ci-pool-image: failed (exit $rc) at line $LINENO: $BASH_COMMAND" >&2' ERR
trap '$LXC delete --force "$work" >/dev/null 2>&1 || true' EXIT

# The build container is made on the pool profile it will run with (so Docker works in it), at the pool's size.
$LXC launch ubuntu:24.04 "$work" --profile "ci-pool-$kind"
$LXC exec "$work" -- cloud-init status --wait >/dev/null || true
$LXC file push "$SHARE/ci-pool-entrypoint" "$work/usr/local/sbin/ci-pool-entrypoint" --mode 0755
$LXC file push "$SHARE/ci-pool-runner.service" "$work/etc/systemd/system/ci-pool-runner.service" --mode 0644
# -T: no terminal. The provisioning logs itself inside the container; if it fails, its tail is printed before the EXIT trap
# deletes the container, since the service's journal otherwise says only that the build exited.
rc=0
$LXC exec -T "$work" --env KIND="$kind" --env NODE_MAJOR="$NODE_MAJOR" --env POSTGRES_IMAGE="$POSTGRES_IMAGE" \
  --env TMP_SIZE="$TMP_SIZE" --env TRUSTED_ACTORS="${actors[*]}" -- bash -s <<'PROVISION' || rc=$?
set -Eeuo pipefail  # -E: the ERR trap below also fires inside a function, such as purge_updaters
umask 022
exec > >(tee -a /var/log/ci-pool-provision.log) 2>&1
set -x
trap 'rc=$?; echo "ci-pool-image: provisioning failed (exit $rc) at line $LINENO: $BASH_COMMAND" >&2' ERR
export DEBIAN_FRONTEND=noninteractive
# No apt activity in a job (I-121's second cause). A fresh container has missed apt-daily-upgrade.timer (Persistent), so it
# fires up to an hour after boot, into any long job; unattended-upgrades then upgrades packages, and needrestart's apt hook,
# automatic where there is no terminal, reexecutes systemd and restarts every service on an old library, ci-pool-runner.service
# with them, which cancels the job. needrestart goes too because a package a job installs with sudo runs the same hook. Masked,
# not only disabled: an upgrade of apt enables its timers again, and a mask outlives that. PackageKit stays installed
# (software-properties-common depends on it) and masked, so its apt hook and any client cannot start it. Before anything
# else here: an apt run of the timers' own would hold the lock this build needs, so a run in progress is stopped and waited for.
systemctl disable --now apt-daily.timer apt-daily-upgrade.timer
systemctl stop apt-daily.service apt-daily-upgrade.service
systemctl mask apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service \
  packagekit.service packagekit-offline-update.service
purge_updaters() {
  local pkg
  for pkg in needrestart unattended-upgrades; do  # needrestart first, so the second purge does not run its hook
    if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then
      apt-get -o DPkg::Lock::Timeout=300 purge -y "$pkg"
    fi
  done
}
purge_updaters
# No rsyslog: nothing in a CI job reads /var/log/syslog (containers log to journald), and the image's rsyslogd AppArmor profile
# denies journald's send to /run/systemd/journal/dev-log, about 6,700 denials a day on the host (I-104). Only when the
# base image has it: this runs before `apt-get update`, and apt cannot find a package it has no list for.
if dpkg-query -W -f='${Status}' rsyslog 2>/dev/null | grep -q 'install ok installed'; then
  apt-get purge -y rsyslog
fi
apt-get update
apt-get install -y ca-certificates curl jq sudo xz-utils software-properties-common
add-apt-repository -y ppa:git-core/ppa
install -m 0755 -d /etc/apt/keyrings
# where ci-pool pushes the runner's just-in-time config (lxc file push does not create directories)
install -d -m 0700 /etc/ci-pool
curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg
chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list
apt-get update
apt-get install -y git gh

# the `runner` user: sudo in a build container (Playwright and test setups add packages), none in a gate container
id runner >/dev/null 2>&1 || useradd -m -s /bin/bash runner
if [ "$KIND" = build ]; then echo 'runner ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/runner; chmod 0440 /etc/sudoers.d/runner; fi

# Node, from nodejs.org, checked against the SHASUMS file of the same release directory
case "$(uname -m)" in x86_64) arch=x64; rarch=x64 ;; aarch64) arch=arm64; rarch=arm64 ;; *) echo "unsupported machine" >&2; exit 1 ;; esac
base="https://nodejs.org/dist/latest-v${NODE_MAJOR}.x"
file="$(curl -fsSL "$base/SHASUMS256.txt" | awk -v a="linux-$arch.tar.xz" '$2 ~ a"$" {print $2}' | head -n1)"
[ -n "$file" ] || { echo "no Node ${NODE_MAJOR} download found" >&2; exit 1; }
curl -fsSL -o "/tmp/$file" "$base/$file"
(cd /tmp && curl -fsSL "$base/SHASUMS256.txt" | grep " $file\$" | sha256sum -c -)
tar -xJf "/tmp/$file" -C /usr/local --strip-components=1
rm -f "/tmp/$file"

# the Actions runner, not registered; checksum from the release, as runner-setup does
release="$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest)"
version="$(jq -r .tag_name <<<"$release")"; version="${version#v}"
sha="$(jq -r .body <<<"$release" | sed -n "s/.*<!-- BEGIN SHA linux-${rarch} -->\([0-9a-f]\{64\}\)<!-- END SHA linux-${rarch} -->.*/\1/p" | head -n1)"
[ -n "$sha" ] || { echo "The runner release publishes no linux-${rarch} checksum; stopping." >&2; exit 1; }
curl -fsSL -o /tmp/runner.tar.gz "https://github.com/actions/runner/releases/download/v${version}/actions-runner-linux-${rarch}-${version}.tar.gz"
chmod 0644 /tmp/runner.tar.gz
echo "${sha}  /tmp/runner.tar.gz" | sha256sum -c -
install -d -o runner -g runner /opt/actions-runner
sudo -u runner tar xzf /tmp/runner.tar.gz -C /opt/actions-runner
rm /tmp/runner.tar.gz
/opt/actions-runner/bin/installdependencies.sh >/dev/null

# The job-started check, in both kinds (ci-pool-entrypoint sets ACTIONS_RUNNER_HOOK_JOB_STARTED to it, and starts no runner
# without it), and the trusted accounts it reads. Root's and read-only to the runner, and a container serves one job, so no
# job's code has run before it.
install -d -m 0755 /opt/ci-hooks
read -ra actors <<<"$TRUSTED_ACTORS"
printf '%s\n' "${actors[@],,}" > /opt/ci-hooks/trusted-actors
chmod 0644 /opt/ci-hooks/trusted-actors
cat > /opt/ci-hooks/job-started.sh <<'JOBHOOK'
#!/bin/bash
# ci-pool's job-started check (ACTIONS_RUNNER_HOOK_JOB_STARTED, set by ci-pool-entrypoint). The runner runs it as the
# `runner` user once GitHub has given it the job, before any step, job container, service or action of the job. The job
# goes on only when a trusted account (/opt/ci-hooks/trusted-actors, from ci-pool-image's TRUSTED_ACTORS) started the run
# (GITHUB_ACTOR) and this attempt (GITHUB_TRIGGERING_ACTOR), and a pull request's head repository is its base repository
# (no fork). The runner takes these from GitHub's job message: it exports them from the job's github context and writes the
# event payload to GITHUB_EVENT_PATH before this runs, and no code of the job has run yet that could change them. The job's
# own `env:` does not reach this process (server/ci-runner/README.md says why). A value that is missing or cannot be read
# refuses.
# A failed hook fails the job, but the runner still runs each later step whose own `if:` holds, as `always()` does, and a
# pull request's workflow file is its author's. So a refusal kills the job's Runner.Worker, and where it cannot find it, in
# the pool image, every process of the runner's user: no step runs at all.
set -uo pipefail
list=/opt/ci-hooks/trusted-actors
worker_exe='/opt/actions-runner/bin*/Runner.Worker'  # the runner's Worker (bin.VERSION after a self-update)
allowed=no
reason="the check stopped before it finished"
# What a refusal reports beside its reason (stop_job): the values as the runner gave them, and the repositories once read.
event="${GITHUB_EVENT_NAME-}"
actor="${GITHUB_ACTOR-}"
triggering="${GITHUB_TRIGGERING_ACTOR-}"
repository="${GITHUB_REPOSITORY-}"
pr_repos=""    # "HEAD into BASE" of the payload's pull request
run_repos=""   # "HEAD in REPOSITORY" of the payload's workflow run
shown() { local v="${1//[^A-Za-z0-9._\/\[\]-]/?}"; printf '%s' "${v:0:120}"; }
said() { if [[ -n "$1" ]]; then shown "$1"; else printf 'not set'; fi; }
# The Runner.Worker that started this check: its parent, or the parent's parent (a runner that wraps hooks in a shell),
# by name and by executable. Never further up: a test of this check runs under some other runner's Worker.
find_worker() {
  local pid="$PPID" depth comm exe key value rest
  for depth in 1 2; do
    [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || return 1
    read -r comm < "/proc/$pid/comm" || return 1
    exe="$(/usr/bin/readlink "/proc/$pid/exe")" || exe=""
    # shellcheck disable=SC2053  # the right side is a pattern
    if [[ "$comm" == Runner.Worker && "$exe" == $worker_exe ]]; then
      printf '%s' "$pid"
      return 0
    fi
    value=""
    while IFS=$':\t ' read -r key value rest; do [[ "$key" == PPid ]] && break; value=""; done < "/proc/$pid/status"
    pid="$value"
  done
  return 1
}
stop_job() {
  local worker lines
  # Which check failed, and the values it read: the actors, the event, the repository and the repositories of the
  # payload's pull request or workflow run.
  lines="$(printf '::error::ci-pool refused this job: %s\n' "$reason"
           printf '::error::ci-pool: event %s, actor %s, triggering actor %s, repository %s, pull request %s, workflow run %s\n' \
             "$(said "$event")" "$(said "$actor")" "$(said "$triggering")" "$(said "$repository")" \
             "${pr_repos:-none}" "${run_repos:-none}")"
  printf '%s\n' "$lines"
  if worker="$(find_worker)"; then
    # Also to the Worker's own stderr: the runner's Listener attaches what its Worker printed to the failed job as an
    # error when the Worker dies, so the refusal stays on the job, though the killed Worker uploads no more of this log.
    # Appended (never truncating what fd 2 points at), in the background and for 1 s at most: a write that blocks (a
    # full pipe nobody drains) is killed, and the kill below never waits for it.
    /usr/bin/timeout -s KILL 1 /usr/bin/bash -c 'printf "%s\n" "$1" >> "$2"' ci-pool-job-started "$lines" "/proc/$worker/fd/2" &
    /usr/bin/sleep 3 || true  # so the lines above reach the job's live log first
    kill -KILL "$worker" || true
  elif [[ "${BASH_SOURCE[0]}" == /opt/ci-hooks/job-started.sh && $EUID -ne 0 ]]; then
    # The pool image's own check, as the runner's user, in a container that serves this one job: end every process of
    # that user (the runner's Listener and Worker; not this one).
    /usr/bin/sleep 3 || true
    kill -KILL -1 || true
  else
    printf '::error::ci-pool: this check found no Runner.Worker and is not the pool image'"'"'s own, so it cannot stop the job: the job fails, but its always() steps may still run\n'
  fi
}
# Every way out but the one at the end refuses, an unexpected error included.
trap '[ "$allowed" = yes ] || { stop_job; exit 1; }' EXIT
refuse() { reason="$1"; exit 1; }
trusted=()
mapfile -t trusted < "$list" || refuse "the trusted accounts ($list) cannot be read"
is_trusted() {
  local who="${1,,}" t
  for t in "${trusted[@]}"; do [[ -n "$t" && "$who" == "${t,,}" ]] && return 0; done
  return 1
}
for name in GITHUB_ACTOR GITHUB_TRIGGERING_ACTOR; do
  value="${!name-}"
  [[ -n "$value" ]] || refuse "$name is not set"
  is_trusted "$value" || refuse "$name is $(shown "$value"), not a trusted account"
done
[[ -n "$event" ]] || refuse "GITHUB_EVENT_NAME is not set"
payload="${GITHUB_EVENT_PATH-}"
[[ -n "$payload" && -f "$payload" && -r "$payload" ]] || refuse "the event payload (GITHUB_EVENT_PATH) is missing or unreadable"
# One value a line, then "." (command substitution drops trailing empty lines): whether the payload has a pull request,
# its head and base repositories, whether it has a workflow run, and that run's head repository and repository.
fields="$(/usr/bin/jq -r '
  def name(p): (try p catch null) | if type == "string" then . else "" end;
  if type != "object" then error("not an object") else
    (has("pull_request") | tostring),
    name(.pull_request.head.repo.full_name), name(.pull_request.base.repo.full_name),
    (has("workflow_run") | tostring),
    name(.workflow_run.head_repository.full_name), name(.workflow_run.repository.full_name),
    "."
  end' "$payload")" || refuse "the event payload is not one JSON object (the reader's error is above)"
mapfile -t f <<<"$fields"
[[ ${#f[@]} -eq 7 && "${f[6]}" == . ]] || refuse "the event payload is not one JSON object"
[[ "${f[0]}" != true ]] || pr_repos="$(said "${f[1]}") into $(said "${f[2]}")"
[[ "${f[3]}" != true ]] || run_repos="$(said "${f[4]}") in $(said "${f[5]}")"
case "$event" in
  pull_request | pull_request_target | pull_request_review | pull_request_review_comment)
    [[ "${f[0]}" == true ]] || refuse "a $event event whose payload has no pull request" ;;
  workflow_run)
    [[ "${f[3]}" == true ]] || refuse "a workflow_run event whose payload has no workflow run" ;;
esac
# A payload with a pull request, whatever the event: the review and review-comment events run the pull request's code too.
# (An issue_comment payload names its pull request only by URL: its workflow runs from the base branch, and the actor
# check is what applies to it.)
if [[ "${f[0]}" == true ]]; then
  [[ -n "${f[1]}" && -n "${f[2]}" ]] || refuse "the pull request's head or base repository is missing (a deleted fork reads so)"
  [[ "${f[1]}" == "${f[2]}" ]] || refuse "a pull request from $(shown "${f[1]}") into $(shown "${f[2]}"), another repository"
fi
# A workflow_run run can act on what a fork's run left (its artifacts)
if [[ "${f[3]}" == true ]]; then
  [[ -n "${f[4]}" && -n "${f[5]}" ]] || refuse "the workflow run's head repository or repository is missing"
  [[ "${f[4]}" == "${f[5]}" ]] || refuse "a workflow run of $(shown "${f[4]}") in $(shown "${f[5]}"), another repository"
fi
printf 'ci-pool: a %s run of %s, this attempt by %s: allowed\n' "$(shown "$event")" "$(shown "$GITHUB_ACTOR")" \
  "$(shown "$GITHUB_TRIGGERING_ACTOR")"
allowed=yes
exit 0
JOBHOOK
chmod 0755 /opt/ci-hooks/job-started.sh

if [ "$KIND" = build ]; then
  # Docker, then the hook that clears it after every job, then what jobs would otherwise download
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
  apt-get update
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  usermod -aG docker runner
  install -d /opt/ci-hooks
  cat > /opt/ci-hooks/clean-docker.sh <<'HOOK'
#!/usr/bin/env bash
# After every job (ACTIONS_RUNNER_HOOK_JOB_COMPLETED): remove every container, volume and network. A pool container serves
# one job, so this only matters to a job that starts Docker work and leaves it running when it ends.
docker ps -aq | xargs -r docker rm -f >/dev/null 2>&1
docker volume prune -af >/dev/null 2>&1
docker network prune -f >/dev/null 2>&1
exit 0
HOOK
  chmod 0755 /opt/ci-hooks/clean-docker.sh
  systemctl start docker
  docker pull "$POSTGRES_IMAGE"
  # Playwright's browsers and their system libraries, where a project's own Playwright finds them; a project on another
  # Playwright version downloads its own browsers, the libraries still being there.
  mkdir -p /opt/ms-playwright
  PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright npx --yes playwright install --with-deps chromium firefox webkit
  echo 'PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright' >> /etc/environment
  chmod -R a+rX /opt/ms-playwright
  # The job's own `playwright install` takes a lock inside this directory even when the browsers are there (mkdir
  # __dirlock), and a project on another Playwright version adds its browsers here: the runner owns it. A container
  # serves one job, so nothing it writes here reaches another job.
  chown -R runner:runner /opt/ms-playwright
  systemctl stop docker docker.socket
  # the pre-pulled images stay; nothing else Docker made at build time does
  rm -rf /var/lib/docker/tmp/* 2>/dev/null || true
fi

# A container never upgrades itself, so the build does: every package is current here, not only the ones named above. Here
# for both kinds, after the last refresh of the lists. confdef and confold, with stdin closed: dpkg has no one to ask about a
# changed configuration file, and this script is itself read from stdin.
apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade </dev/null
# Again, after the last install and the upgrade: ubuntu-server recommends both packages, so either could bring one back.
purge_updaters

# /tmp in RAM (counts against the container's memory limit): tests that write many small files are several times faster.
# The ubuntu:24.04 container image ships no /etc/fstab, and sed -i exits 2 on a missing file.
touch /etc/fstab
sed -i '\#^tmpfs[[:space:]]\+/tmp[[:space:]]#d' /etc/fstab
echo "tmpfs /tmp tmpfs defaults,noatime,nosuid,nodev,size=${TMP_SIZE},mode=1777 0 0" >> /etc/fstab
systemctl enable ci-pool-runner.service
# the image carries no machine identity, token or log
cloud-init clean --logs
rm -f /var/log/ci-pool-provision.log
truncate -s 0 /etc/machine-id
rm -rf /var/lib/apt/lists/*
PROVISION
if [[ $rc -ne 0 ]]; then
  echo "ci-pool-image: provisioning failed (exit $rc); the last 200 lines of its log:" >&2
  $LXC exec -T "$work" -- tail -n 200 /var/log/ci-pool-provision.log >&2 || true
  exit "$rc"
fi
$LXC stop "$work"
# Publish under a new alias first, then rotate: a build that fails leaves the current image and its -prev as they were.
# A -new left by a build that failed after its publish names an image nothing else keeps: delete that image, not
# only its alias, unless it is the current or the -prev one (published images do not expire).
stale_fp="$($LXC image info "$alias-new" 2>/dev/null | awk '/^Fingerprint:/ {print $2}')" || stale_fp=""
if [[ -n "$stale_fp" ]]; then
  keep_cur="$($LXC image info "$alias" 2>/dev/null | awk '/^Fingerprint:/ {print $2}')" || keep_cur=""
  keep_prev="$($LXC image info "$alias-prev" 2>/dev/null | awk '/^Fingerprint:/ {print $2}')" || keep_prev=""
  if [[ "$stale_fp" != "$keep_cur" && "$stale_fp" != "$keep_prev" ]]; then
    $LXC image delete "$stale_fp" || echo "ci-pool-image: could not delete the stale image $stale_fp; delete it by hand." >&2
  fi
fi
$LXC image alias delete "$alias-new" >/dev/null 2>&1 || true
$LXC publish "$work" --alias "$alias-new" "description=ci-pool $kind $(date -u +%F)"
new_fp="$($LXC image info "$alias-new" | awk '/^Fingerprint:/ {print $2}')" || new_fp=""
if [[ -z "$new_fp" ]]; then
  echo "ci-pool-image: no fingerprint for $alias-new; the current image is unchanged (the next build deletes $alias-new)." >&2
  exit 1
fi
if $LXC image alias list --format csv | cut -d, -f1 | grep -qx "$alias"; then
  # The image behind the old -prev alias would stay unaliased for ever (published images do not expire): delete it by
  # fingerprint first, unless it is the very image being kept.
  prev_fp="$($LXC image info "$alias-prev" 2>/dev/null | awk '/^Fingerprint:/ {print $2}')" || prev_fp=""
  cur_fp="$($LXC image info "$alias" 2>/dev/null | awk '/^Fingerprint:/ {print $2}')" || cur_fp=""
  $LXC image alias delete "$alias-prev" >/dev/null 2>&1 || true
  if [[ -n "$prev_fp" && "$prev_fp" != "$cur_fp" ]]; then
    $LXC image delete "$prev_fp" || echo "ci-pool-image: could not delete the old image $prev_fp; delete it by hand." >&2
  fi
  if [[ -n "$cur_fp" ]]; then
    $LXC image alias create "$alias-prev" "$cur_fp"
    had_prev=1
  fi
  # The pool launches from "$alias" at any moment: repoint it in one API call (PATCH of its target), never a delete and a
  # create or two renames, so a launch always finds either the old image or the new one.
  $LXC query -X PATCH "/1.0/images/aliases/$alias" --data "{\"target\": \"$new_fp\"}" >/dev/null
  $LXC image alias delete "$alias-new"
else
  $LXC image alias rename "$alias-new" "$alias"
fi
echo "Image $alias published${had_prev:+; the previous one is $alias-prev}."
