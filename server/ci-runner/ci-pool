DIAG_WHY = ("unassigned", "hard_timeout")  # the deletions that keep a diagnostic copy
DIAG_NAME_RE = re.compile(r"^[A-Za-z0-9_.-]{1,100}\.log$")  # the only file names taken from a container: *.log, nothing else
DIAG_DIR_RE = re.compile(r"^[0-9]+(\.[0-9]+)?$")  # the only entries retention may remove from the diag directory
DIAG_LIST_LIMIT = 65536  # bytes read from a container's file listing
DIAG_CALL_SECONDS = 20  # one lxc call of the copy
