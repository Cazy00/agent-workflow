def mem_mib(text):
    """A memory limit such as 5GiB in MiB; None when it is not of the form <digits><MiB|GiB|MB|GB>."""
    m = MEM_RE.match(str(text))
    if not m:
        return None
    return int(m.group(1)) * {"MiB": 1, "GiB": 1024, "MB": 1000000 / 1048576, "GB": 1000000000 / 1048576}[m.group(2)]


def log(event, **fields):
    print(json.dumps({"ts": round(time.time(), 3), "event": event, **fields}, sort_keys=True), flush=True)


class PoolError(Exception):
    pass


# ── lxc: the one place that runs it ──────────────────────────────────────────────────────────────────────────────
class Lxc:
    def __init__(self, binary, timeout=120):
        self.binary = binary
        self.timeout = timeout

    def _run(self, *args, data=None):
        try:
            r = subprocess.run([self.binary, *args], input=data, capture_output=True, text=True, timeout=self.timeout)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise PoolError(f"lxc {args[0]}: {e}") from e
        if r.returncode != 0:
            raise PoolError(f"lxc {' '.join(args[:2])} failed: {r.stderr.strip()[:300]}")
        return r.stdout

    def list(self):
        """Every instance as {name, status, created_at (epoch), base_image}."""
        out = []
        for i in json.loads(self._run("list", "--format", "json") or "[]"):
            out.append({
                "name": i["name"],
                "status": i.get("status", ""),
                "created_at": _epoch(i.get("created_at", "")),
                "base_image": (i.get("config") or {}).get("volatile.base_image", ""),
            })
        return out

    def image_fingerprint(self, alias):
        """The fingerprint the alias points at, or '' when there is no such image."""
        try:
            for i in json.loads(self._run("image", "list", "--format", "json", alias) or "[]"):
                if any(a.get("name") == alias for a in i.get("aliases", [])):
                    return i["fingerprint"]
        except PoolError:
            pass
        return ""

    def init(self, name, image, profile, memory):
        """A stopped instance from the image, on the pool profile only (not `default`: the pool profile has its own root disk)."""
        self._run("init", image, name, "--profile", profile, "--config", f"limits.memory={memory}")

    def rename(self, old, new):
        self._run("rename", old, new)

    def push_secret(self, name, path, data):
        """Write data to path inside the instance (mode 0600) through stdin; works on a stopped instance."""
        self._run("file", "push", "-", f"{name}{path}", "--mode", "0600", data=data)

    def start(self, name):
        self._run("start", name)

    def _exec_bounded(self, name, argv, limit, timeout, user=None, keep_end=False):
        """Run argv inside the instance and return at most `limit` bytes of its output; a process that says more is killed. What
        a container prints is not trusted: it never fills the host's memory. stderr is dropped. `user` = (uid, gid) runs it as
        that user and group instead of root. keep_end: the last `limit` bytes instead of the first, from the first whole line
        in them when the output was longer (a window that starts at a line start keeps that line); at most 4 x `limit` bytes
        are read, then the process is killed."""
        who = [] if user is None else ["--user", str(int(user[0])), "--group", str(int(user[1]))]
        try:
            p = subprocess.Popen([self.binary, "exec", name, *who, "--", *argv], stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL)
        except OSError as e:
            raise PoolError(f"lxc exec: {e}") from e
        timed_out = []
        timer = threading.Timer(timeout, lambda: (timed_out.append(1), p.kill()))
        timer.start()
        try:
            if keep_end:
                out, seen, over = b"", 0, False
                while True:
                    chunk = p.stdout.read1(65536)
                    if not chunk:
                        break
                    seen += len(chunk)
                    out = (out + chunk)[-(limit + 1):]  # one byte more: was the window's first byte a line start?
                    if seen > 4 * limit:
                        over = True
                        p.kill()
                        break
                if seen > limit:  # cut: drop the partial first line; a newline just before the window drops only itself
                    nl = out.find(b"\n")
                    out = out[nl + 1:] if nl >= 0 else b""
            else:
                out = p.stdout.read(limit + 1)
                over = len(out) > limit
                if over:
                    p.kill()
        finally:
            timer.cancel()
            p.stdout.close()
            rc = p.wait()
        if timed_out:
            raise PoolError(f"lxc exec {name} {argv[0]}: timed out after {timeout:.0f}s")
        if rc != 0 and not over:
            raise PoolError(f"lxc exec {name} {argv[0]} exited {rc}")
        return out[:limit]

    def owner(self, name, path, timeout):
        """(uid, gid) that own `path` inside the instance (the path itself, a symbolic link not followed)."""
        out = self._exec_bounded(name, ["stat", "-c", "%u %g", "--", path], 64, timeout).decode("ascii", "replace").split()
        if len(out) != 2 or not all(ID_RE.match(x) for x in out):
            raise PoolError(f"lxc exec {name} stat: cannot read the owner of {path}")
        return int(out[0]), int(out[1])

    def list_logs(self, name, directory, timeout, user):
        """The regular files `*.log` with one link directly in `directory` inside the instance, as [(mtime, size, file name)],
        newest first, listed as `user` (uid, gid). Only names that pass DIAG_NAME_RE are returned."""
        out = self._exec_bounded(name, ["find", directory, "-maxdepth", "1", "-type", "f", "-links", "1", "-name", "*.log",
                                        "-printf", "%T@ %s %f\\n"], DIAG_LIST_LIMIT, timeout, user=user)
        found = []
        for line in out.decode("utf-8", "replace").splitlines():
            parts = line.split(" ", 2)
            try:
                mtime, size, fname = float(parts[0]), int(parts[1]), parts[2]
            except (ValueError, IndexError):
                continue
            if DIAG_NAME_RE.match(fname):
                found.append((mtime, size, fname))
        return sorted(found, reverse=True)

    def tail_file(self, name, path, nbytes, timeout, user):
        """The last `nbytes` bytes (at most) of a file inside the instance, read as `user` (uid, gid)."""
        return self._exec_bounded(name, ["tail", "-c", str(nbytes), "--", path], nbytes, timeout, user=user)

    def journal(self, name, lines, limit, timeout, unit=None):
        """The last `lines` lines of the instance's journal for this boot (of systemd `unit` alone when given), read as root
        (journald's files are root's), at most its last `limit` bytes. Untrusted text."""
        only = [] if unit is None else ["-u", unit]
        return self._exec_bounded(name, ["journalctl", "-b", "--no-pager", "-o", "short-iso-precise", *only,
                                         "-n", str(int(lines))], limit, timeout, keep_end=True)

    def processes(self, name, limit, timeout):
        """The instance's processes with parent, process group, session, user, state, start time and command name (comm: no
        arguments, which can hold a step's secrets), read as root, at most the first `limit` bytes. Untrusted text."""
        return self._exec_bounded(name, ["ps", "-eo", "pid,ppid,pgid,sid,user,stat,lstart,comm"], limit, timeout)

    def workers(self, name, limit, timeout):
        """How many processes named WORKER_COMM run inside the instance (`ps -e -o comm=`, read as root like `processes`).
        Output that fills `limit` is cut, so it is no answer: a PoolError, as is a failed or stuck exec."""
        out = self._exec_bounded(name, ["ps", "-e", "-o", "comm="], limit, timeout)
        if len(out) >= limit:
            raise PoolError(f"lxc exec {name} ps: the process list reached {limit} bytes")
        return sum(1 for line in out.split(b"\n") if line.strip() == WORKER_COMM)

    def delete(self, name):
        self._run("delete", "--force", name)

    def profile_show(self, name):
        return self._run("profile", "show", name)


def _epoch(stamp):
    """LXD's RFC 3339 time as epoch seconds; 0 when unreadable (an unreadable age never reaps early)."""
    m = re.match(r"(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)", stamp or "")
    if not m:
        return 0
    return calendar.timegm(tuple(int(x) for x in m.groups()) + (0, 0, 0))


# ── config and state ─────────────────────────────────────────────────────────────────────────────────────────────
def check_admission(where, adm):
    """Refuse an admission block that names another key, a non-number, a pressure outside 0..100 or a negative memory."""
    if not isinstance(adm, dict):
        raise PoolError(f"config: {where} must be an object")
    for k, v in adm.items():
        if k not in ADMISSION_KEYS:
            raise PoolError(f"config: {where} has an unknown key {k!r} (allowed: {', '.join(ADMISSION_KEYS)})")
        if isinstance(v, bool) or not isinstance(v, (int, float)) or v != v:
            raise PoolError(f"config: {where}.{k} must be a number")
        if k.endswith("_avg60") and not 0 <= v <= 100:
            raise PoolError(f"config: {where}.{k} must be between 0 and 100")
        if k.startswith("min_mem") and v < 0:
            raise PoolError(f"config: {where}.{k} must not be negative")


def label_limits(cfg, label):
    """The admission limits of a label: the global ones overlaid by the label's own."""
    return {**cfg["admission"], **cfg["labels"][label].get("admission", {})}


def diag_dir_refusal(path):
    """Why diag_dir may not be this path, or '': it must be written plainly (no `..`, `//` or trailing `/`), below a top-level
    directory, not a home directory, and not a well-known system or shared directory (DIAG_DIR_REFUSED, anything under
    DIAG_DIR_REFUSED_UNDER). The run-time check in DiagKeeper._root is what protects a directory that is not listed."""
    if os.path.normpath(path) != path or "//" in path:  # normpath keeps a leading //
        return "must be written plainly (no .., // or trailing /)"
    if path.count("/") < 2:
        return "must not be / or a top-level directory"
    if path.startswith("/home/") and path.count("/") == 2:
        return "must not be a home directory"
    if path in DIAG_DIR_REFUSED or any(path == d or path.startswith(d + "/") for d in DIAG_DIR_REFUSED_UNDER):
        return "is a system or shared directory; give the pool a directory of its own (default /var/log/ci-pool/diag)"
    return ""


def load_config(path):
    with open(path) as f:
        user = json.load(f)
    if not isinstance(user, dict):
        raise PoolError("config: must be a JSON object")
    check_admission("admission", user.get("admission", {}))
    cfg = {**DEFAULTS, **user, "admission": {**DEFAULTS["admission"], **user.get("admission", {})}}
    if cfg.get("version") != 1:
        raise PoolError("config: version must be 1")
    for r in cfg.get("repos", []):
        if not REPO_RE.match(r):
            raise PoolError(f"config: bad repo {r!r}")
    if not cfg.get("labels"):
        raise PoolError("config: no labels")
    if not isinstance(cfg["labels"], dict):
        raise PoolError("config: labels must be an object of label -> settings")
    for label, spec in cfg["labels"].items():
        if not LABEL_RE.match(label):
            raise PoolError(f"config: bad label {label!r}")
        if not isinstance(spec, dict):
            raise PoolError(f"config: label {label} must be an object")
        for k in ("profile", "image", "cap", "memory"):
            if k not in spec:
                raise PoolError(f"config: label {label} lacks {k}")
        if isinstance(spec["cap"], bool) or not isinstance(spec["cap"], int) or spec["cap"] < 0:
            raise PoolError(f"config: label {label} cap must be an integer, 0 or more")
        if mem_mib(spec["memory"]) is None:
            raise PoolError(f"config: label {label} memory must look like 5GiB (MiB, GiB, MB or GB)")
        check_admission(f"label {label} admission", spec.get("admission", {}))
    if not isinstance(cfg["diag_dir"], str) or (cfg["diag_dir"] and not os.path.isabs(cfg["diag_dir"])):
        raise PoolError("config: diag_dir must be an absolute path, or \"\" for none")
    if cfg["diag_dir"] and diag_dir_refusal(cfg["diag_dir"]):
        raise PoolError(f"config: diag_dir {cfg['diag_dir']} {diag_dir_refusal(cfg['diag_dir'])}")
    if not isinstance(cfg["diag_runner_dir"], str) or not os.path.isabs(cfg["diag_runner_dir"]):
        raise PoolError("config: diag_runner_dir must be an absolute path")
    for k in ("diag_max_files", "diag_max_file_kb", "diag_max_jobs", "diag_max_mb", "diag_timeout_seconds",
              "diag_pass_budget_seconds"):
        if isinstance(cfg[k], bool) or not isinstance(cfg[k], int) or cfg[k] < 1:
            raise PoolError(f"config: {k} must be an integer, 1 or more")
    for k in ("source_cmd", "jit_cmd"):
        if not (isinstance(cfg.get(k), list) and cfg[k] and all(isinstance(a, str) for a in cfg[k])):
            raise PoolError(f"config: {k} must be a non-empty list of strings")
    return cfg


class State:
    """job id -> {container, repo, label, runner_id, runner_name, started, status, assigned, retry_after, finished}.
    status: launching | running | finished | failed. An entry is written before the container starts and says which
    container, runner and job id a launch was for; it is not a promise about the job (the runner takes any queued job of its
    label). It keeps a launch from repeating while its container is alive, its retry pause runs, or lag_seconds after it ended;
    finished entries stay a day, other entries that outlive the hard timeout without a container are dropped."""

    def __init__(self, path):
        self.path = path
        self.jobs = {}
        if os.path.exists(path):
            with open(path) as f:
                self.jobs = json.load(f).get("jobs", {})

    def save(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        tmp = self.path + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"version": 1, "jobs": self.jobs}, f, indent=1, sort_keys=True)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, self.path)

    def by_container(self, name):
        for jid, e in self.jobs.items():
            if e["container"] == name and e["status"] in ("launching", "running"):
                return jid, e
        return None, None


# ── host pressure ────────────────────────────────────────────────────────────────────────────────────────────────
def read_host():
    """MemAvailable (MiB) and the avg60 of PSI 'some' for cpu and memory; None where unreadable."""
    def psi(kind):
        try:
            with open(f"/proc/pressure/{kind}") as f:
                for line in f:
                    if line.startswith("some "):
                        return float(dict(p.split("=") for p in line.split()[1:])["avg60"])
        except (OSError, ValueError, KeyError):
            pass
        return None
    mem = None
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemAvailable:"):
                    mem = int(line.split()[1]) // 1024
    except (OSError, ValueError):
        pass
    return {"mem_available_mib": mem, "cpu_psi": psi("cpu"), "mem_psi": psi("memory")}


def read_memory(name, root="/sys/fs/cgroup"):
    """A running container's cgroup memory.peak (MiB, rounded up) and memory.events oom_kill; None for what is unreadable
    (a stopped container has no cgroup). LXD puts each instance in lxc.payload.<name> at the cgroup root."""
    base = os.path.join(root, f"lxc.payload.{name}")
    peak = oom = None
    try:
        with open(os.path.join(base, "memory.peak")) as f:
            peak = -(-int(f.read().strip()) // (1024 * 1024))
    except (OSError, ValueError):
        pass
    try:
        with open(os.path.join(base, "memory.events")) as f:
            for line in f:
                k, _, v = line.partition(" ")
                if k == "oom_kill":
                    oom = int(v)
    except (OSError, ValueError):
        pass
    return {"memory_peak_mib": peak, "oom_kill": oom}


class DiagKeeper:
    """Keeps what explains a container that is about to be deleted without its job's outcome (I-121): the runner's `_diag/*.log`
    files (the signal or lost Worker that ended a cancelled step shows there), the container's cgroup `memory.events` and
    `memory.peak`, and, read as root inside it, its process list `ps.txt` (command names, no arguments), the end of
    ci-pool-runner.service's journal `journal-runner.txt` and the end of its whole journal for this boot `journal.txt` (a
    systemd stop of ci-pool-runner.service, or which process group survived a kill, shows there; all three are untrusted
    text, written as data with sudo's logged commands and the runner's just-in-time config removed, `scrub`), in
    `<diag_dir>/<job id>/`, mode 0700 for directories and 0600 for files, root only. Bounded at every step:
    the newest `diag_max_files` logs, the last `diag_max_file_kb` KiB of each, DIAG_PS_LIMIT and DIAG_JOURNAL_LIMIT bytes and
    DIAG_SNAPSHOT_SECONDS for the process list and each journal, `diag_max_jobs` directories and `diag_max_mb` MB
    in all (the oldest directory goes first), `diag_timeout_seconds` for the copy of one container and
    `diag_pass_budget_seconds` for all copies of one pass; a stop request ends the copying. Only `*.log` names matching
    DIAG_NAME_RE, regular files with one link, are listed and read, from the one directory `diag_runner_dir`, as the user that
    owns it (never as root): the allowlist filters names; what is in `_diag` is written by job code and is not trusted.
    `diag_dir` is the pool's own: made 0700 when missing, refused when it exists and is not a directory of the pool's user
    with mode 0700; retention removes only job directories holding the pool's `meta.json`. A failure is logged and never
    stops the delete (ci-pool.contract.md)."""

    def __init__(self, cfg, lxc, clock=time.time, cgroup_root="/sys/fs/cgroup", stopping=lambda: False):
        self.cfg, self.lxc, self.clock, self.cgroup_root, self.stopping = cfg, lxc, clock, cgroup_root, stopping
        self.pass_deadline = None  # set by start_pass; None = no pass under way, no pass budget

    def start_pass(self):
        """A reap pass begins: its copies together get diag_pass_budget_seconds from now."""
        self.pass_deadline = self.clock() + self.cfg["diag_pass_budget_seconds"]

    def keep(self, name, entry, jid, why):
        """Copy for one container; returns the directory kept, or None (nothing kept, or already kept for this entry)."""
        cfg = self.cfg
        if not cfg["diag_dir"] or why not in DIAG_WHY or entry is None or entry.get("diag"):
            return None
        if self.stopping():
            log("diag_failed", container=name, job=jid, step="stopping", error="the pool is stopping; deleted without a copy")
            return None
        if self.pass_deadline is not None and self.clock() >= self.pass_deadline:
            log("diag_failed", container=name, job=jid, step="budget",
                error=f"this pass spent its diag_pass_budget_seconds ({cfg['diag_pass_budget_seconds']}); deleted without a copy")
            return None
        try:
            return self._keep(name, entry, jid, why)
        except Exception as e:  # not only PoolError: nothing here may stop the delete
            log("diag_failed", container=name, job=jid, step="keep", error=f"{type(e).__name__}: {e}")
            return None

    def _keep(self, name, entry, jid, why):
        cfg = self.cfg
        root = cfg["diag_dir"]
        if not DIAG_DIR_RE.match(str(jid)):
            raise ValueError(f"job id {jid!r} is not digits")
        refused = self._root(root)
        if refused:
            log("diag_failed", container=name, job=jid, step="diag_dir", error=refused)
            return None
        dest = self._new_dir(root, str(jid))
        deadline = self.clock() + cfg["diag_timeout_seconds"]
        if self.pass_deadline is not None:
            deadline = min(deadline, self.pass_deadline)
        kept, total = [], 0

        def left():
            return max(1.0, min(DIAG_CALL_SECONDS, deadline - self.clock()))

        def put(fname, data):
            nonlocal total
            fd = os.open(os.path.join(dest, fname), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "wb") as f:
                os.fchmod(f.fileno(), 0o600)
                f.write(data)
            kept.append(fname)
            total += len(data)

        def out_of_time(step):
            if self.clock() > deadline or self.stopping():
                log("diag_failed", container=name, job=jid, step=step,
                    error="the pool is stopping" if self.stopping() else "copy time is up")
                return True
            return False

        try:
            for fname in ("memory.events", "memory.peak"):
                try:
                    with open(os.path.join(self.cgroup_root, f"lxc.payload.{name}", fname), "rb") as f:
                        put(fname, f.read(4096))
                except OSError as e:
                    log("diag_failed", container=name, job=jid, step=fname, error=str(e))
            snapshots = ((DIAG_PS, lambda t: self.lxc.processes(name, DIAG_PS_LIMIT, t)),
                         (DIAG_JOURNAL_RUNNER, lambda t: self.lxc.journal(name, DIAG_JOURNAL_RUNNER_LINES, DIAG_JOURNAL_LIMIT, t,
                                                                          unit=DIAG_RUNNER_UNIT)),
                         (DIAG_JOURNAL, lambda t: self.lxc.journal(name, DIAG_JOURNAL_LINES, DIAG_JOURNAL_LIMIT, t)))
            for fname, read in snapshots:  # who signalled the runner: a systemd stop, or a kill of its process group
                if out_of_time(fname):
                    break
                try:
                    put(fname, scrub(read(min(DIAG_SNAPSHOT_SECONDS, left()))))
                except (PoolError, OSError) as e:
                    log("diag_failed", container=name, job=jid, step=fname, error=str(e))
            try:
                nbytes = cfg["diag_max_file_kb"] * 1024
                rdir = cfg["diag_runner_dir"]
                user = self.lxc.owner(name, rdir, left())  # read as the runner, never as root: a link to a root-only file fails
                if user[0] == 0:
                    raise PoolError(f"{rdir} is owned by root; not read as root")
                listed = [f for f in self.lxc.list_logs(name, rdir, left(), user) if DIAG_NAME_RE.match(f[2])]
                for _, _, fname in listed[:cfg["diag_max_files"]]:
                    if out_of_time(fname):
                        break
                    try:
                        put(fname, self.lxc.tail_file(name, f"{rdir}/{fname}", nbytes, left(), user))
                    except (PoolError, OSError) as e:
                        log("diag_failed", container=name, job=jid, step=fname, error=str(e))
            except PoolError as e:
                log("diag_failed", container=name, job=jid, step="list", error=str(e))
            if kept:
                meta = {"job": jid, "container": name, "why": why, "repo": entry.get("repo"), "label": entry.get("label"),
                        "runner_name": entry.get("runner_name"), "started": entry.get("started"), "kept_at": self.clock()}
                try:  # last: a directory without it is never kept, so retention can always remove what the pool kept
                    put(DIAG_META, json.dumps(meta, sort_keys=True, indent=1).encode())
                except OSError as e:
                    log("diag_failed", container=name, job=jid, step=DIAG_META, error=str(e))
                    kept = []
        finally:
            if not kept:
                shutil.rmtree(dest, ignore_errors=True)
        if not kept:
            return None
        entry["diag"] = dest
        log("diag_kept", container=name, job=jid, why=why, path=dest, files=sorted(kept), bytes=total)
        self._prune(root, dest, name, jid)
        return dest

    @staticmethod
    def _root(root):
        """Make diag_dir (0700) when it does not exist; an existing one is never changed and must be a real directory of this
        process's user with mode 0700 (root's own, in service). Returns why it is refused, or ''."""
        os.makedirs(os.path.dirname(root), exist_ok=True)
        try:
            os.mkdir(root, 0o700)
            os.chmod(root, 0o700)  # the pool made it: a tight umask must not leave it unwritable
            return ""
        except FileExistsError:
            pass
        st = os.lstat(root)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or stat.S_IMODE(st.st_mode) != 0o700:
            return (f"{root} exists and is not a directory of uid {os.geteuid()} with mode 0700 "
                    f"(uid {st.st_uid}, mode {stat.S_IMODE(st.st_mode):o}); left as it is, nothing copied")
        return ""

    @staticmethod
    def _new_dir(root, jid):
        """<root>/<jid>, or <jid>.<n> when it exists (a job id the pool launched twice); mode 0700."""
        n = 0
        while True:
            path = os.path.join(root, jid if n == 0 else f"{jid}.{n}")
            try:
                os.mkdir(path, 0o700)
            except FileExistsError:
                n += 1
                continue
            os.chmod(path, 0o700)
            return path

    @staticmethod
    def _ours(path):
        try:
            return stat.S_ISREG(os.lstat(os.path.join(path, DIAG_META)).st_mode)
        except OSError:
            return False

    def _prune(self, root, keep_path, name, jid):
        """Remove the oldest job directories while there are more than diag_max_jobs or they hold more than diag_max_mb. Only
        real directories named like a job directory and holding the pool's meta.json (a regular file) are counted or touched;
        the one just written stays."""
        try:
            dirs = []
            for entry in os.scandir(root):
                if DIAG_DIR_RE.match(entry.name) and entry.is_dir(follow_symlinks=False) and self._ours(entry.path):
                    size = sum(os.lstat(os.path.join(entry.path, f)).st_size for f in os.listdir(entry.path))
                    dirs.append((entry.stat(follow_symlinks=False).st_mtime, entry.path, size))
            dirs.sort()
            count, total = len(dirs), sum(d[2] for d in dirs)
            for _, path, size in dirs:
                if (count <= self.cfg["diag_max_jobs"] and total <= self.cfg["diag_max_mb"] * 1048576) or path == keep_path:
                    break
                shutil.rmtree(path)
                count, total = count - 1, total - size
                log("diag_removed", path=path, why="retention")
        except OSError as e:
            log("diag_failed", container=name, job=jid, step="retention", error=str(e))


def scrub(data):
    """Untrusted container output with sudo's logged commands (DIAG_SUDO) and the runner's just-in-time config (DIAG_SCRUB)
    taken out."""
    lines = data.split(b"\n")
    for i, line in enumerate(lines):
        who = DIAG_SUDO[0].search(line)
        cmd = who and DIAG_SUDO[1].search(line, who.end())
        if cmd:
            lines[i] = line[:cmd.end()] + b"[removed by ci-pool]"
    data = DIAG_SCRUB[0].sub(rb"\1[removed by ci-pool]", b"\n".join(lines))
    return DIAG_SCRUB[1].sub(b"[long token removed by ci-pool]", data)


def admission_refusal(host, limits):
    """Why a container may not start now, or '' when it may. A reading that is missing refuses. A CPU limit of 100 or more
    means CPU pressure does not hold the label (avg60 never exceeds 100), though its reading must still exist."""
    if host["mem_available_mib"] is None or host["mem_available_mib"] < limits["min_mem_available_mib"]:
        return f"MemAvailable {host['mem_available_mib']} MiB below {limits['min_mem_available_mib']}"
    if host["cpu_psi"] is None or (limits["max_cpu_psi_avg60"] < 100 and host["cpu_psi"] >= limits["max_cpu_psi_avg60"]):
        return f"cpu pressure avg60 {host['cpu_psi']} not below {limits['max_cpu_psi_avg60']}"
    if host["mem_psi"] is None or host["mem_psi"] >= limits["max_mem_psi_avg60"]:
        return f"memory pressure avg60 {host['mem_psi']} not below {limits['max_mem_psi_avg60']}"
    return ""


# ── the pool ─────────────────────────────────────────────────────────────────────────────────────────────────────
class Pool:
    def __init__(self, cfg, lxc, state, run_cmd=None, host=read_host, clock=time.time, memory=read_memory,
                 diag=None, stopping=lambda: False):
        self.cfg, self.lxc, self.state, self.host, self.clock, self.memory = cfg, lxc, state, host, clock, memory
        self.diag = diag or DiagKeeper(cfg, lxc, clock, stopping=stopping)
        self.run_cmd = run_cmd or self._run_cmd
        self.pass_calls = 0   # API calls the source reported for the pass under way (ci-pool.contract.md, `api_calls`)
        self.last_calls = 0   # ... and for the last whole pass; the poll pause is stretched to keep it within the budget

    # job source and JIT source: commands from the config (ci-pool.contract.md)
    def _run_cmd(self, argv):
        try:
            r = subprocess.run(argv, capture_output=True, text=True, timeout=self.cfg["command_timeout_seconds"])
        except (OSError, subprocess.TimeoutExpired) as e:
            raise PoolError(f"{argv[0]}: {e}") from e
        if r.returncode != 0:
            raise PoolError(f"{argv[0]} failed: {r.stderr.strip()[:300]}")
        return r.stdout

    def _json(self, argv):
        try:
            doc = json.loads(self.run_cmd(argv))
        except ValueError as e:
            raise PoolError(f"{argv[0]}: not JSON") from e
        if not isinstance(doc, dict) or doc.get("version") != CONTRACT_VERSION:
            raise PoolError(f"{argv[0]}: contract version {doc.get('version') if isinstance(doc, dict) else '?'}, want {CONTRACT_VERSION}")
        return doc

    def _count(self, doc):
        """Add a source answer's `api_calls` to the pass (queued and running only; JIT calls are not counted)."""
        calls = doc.get("api_calls")
        if isinstance(calls, int) and not isinstance(calls, bool) and calls >= 0:
            self.pass_calls += calls

    def queued(self, repo):
        """Queued jobs of a repo that the pool may serve, oldest first; [] for a repo that does not answer as private."""
        doc = self._json(self.cfg["source_cmd"] + ["queued", repo])
        self._count(doc)
        if doc.get("repo") != repo:
            raise PoolError(f"source answered for {doc.get('repo')!r}, asked {repo!r}")
        if doc.get("private") is not True:
            log("repo_refused", repo=repo, why="the source does not say the repository is private")
            return []
        jobs = [j for j in doc.get("jobs", []) if isinstance(j, dict) and ID_RE.match(str(j.get("id", "")))]
        return sorted(jobs, key=lambda j: str(j.get("created_at", "")))

    def running_runner_names(self, repo):
        doc = self._json(self.cfg["source_cmd"] + ["running", repo])
        self._count(doc)
        return {j.get("runner_name") for j in doc.get("jobs", []) if isinstance(j, dict)}

    def jit_create(self, repo, label, name):
        doc = self._json(self.cfg["jit_cmd"] + ["create", repo, label, name])
        if not doc.get("encoded_jit_config") or not doc.get("runner_id"):
            raise PoolError("jit create: no config or runner id")
        return str(doc["runner_id"]), doc["encoded_jit_config"]

    def jit_remove(self, repo, runner_id):
        """Unregister a runner; True when it is gone (a runner that took its job and finished has already gone from GitHub).
        A runner that still holds a job is refused, which is the answer 'not gone'."""
        try:
            self.run_cmd(self.cfg["jit_cmd"] + ["remove", repo, str(runner_id)])
        except PoolError as e:
            log("jit_remove_failed", repo=repo, runner_id=runner_id, error=str(e))
            return False
        return True

    # names
    @staticmethod
    def cname(label, ident):
        return f"pool-{label}-{ident}"

    def label_of(self, name):
        for label in self.cfg["labels"]:
            prefix = f"pool-{label}-"
            if name.startswith(prefix):
                return label, name[len(prefix):]
        return None, None

    # one pass
    def poll_seconds(self):
        """The pause between passes: poll_seconds, but not below what keeps the source within its API budget. A pass costs
        the calls the source reported for the last one (each unfinished run adds a jobs listing), or the fixed estimate
        repositories × api_calls_per_repo_poll when that is more (a source that reports nothing). The reported part is capped
        at MAX_REPORTED_PAUSE."""
        cfg = self.cfg
        fixed = -(-len(cfg["repos"]) * cfg["api_calls_per_repo_poll"] * 3600 // cfg["api_calls_per_hour"])
        reported = min(-(-self.last_calls * 3600 // cfg["api_calls_per_hour"]), MAX_REPORTED_PAUSE)
        return max(int(cfg["poll_seconds"]), MIN_POLL_SECONDS, fixed, reported)

    def tick(self):
        now = self.clock()
        self.pass_calls = 0
        try:
            instances = self.lxc.list()
        except PoolError as e:
            log("lxc_list_failed", error=str(e))
            return
        pool = {i["name"]: i for i in instances if self.label_of(i["name"])[0]}
        try:
            self.reap(pool, now)
            self.state.save()
            pool = {i["name"]: i for i in self.lxc.list() if self.label_of(i["name"])[0]}
            self.launch(pool, now)
            self.keep_spares()
            self.prune(now, pool)
        finally:
            self.state.save()  # what the reap learned must survive a pass that stops half way
            self.last_calls = self.pass_calls

    def reap(self, pool, now):
        cfg = self.cfg
        self.diag.start_pass()  # the copies of this pass share one budget: they never hold launches or a stop for long
        running = {}  # repo -> runner names of jobs in progress, or None when the source did not answer; one ask per repo

        def runners(repo):
            if repo not in running:
                try:
                    running[repo] = self.running_runner_names(repo)
                except PoolError as err:  # unknown is not a reason to delete
                    log("assignment_check_failed", repo=repo, error=str(err))
                    running[repo] = None
            return running[repo]

        for name, inst in pool.items():
            label, ident = self.label_of(name)
            if ident == SPARE:
                continue
            jid, e = self.state.by_container(name)
            if e is None:
                # no record: a container this state does not know. Leave a running one for the hard timeout from LXD's own time.
                if inst["status"] == "Stopped" or (inst["created_at"] and now - inst["created_at"] > cfg["hard_timeout_seconds"]):
                    self._delete(name, None, None, "orphan")
                continue
            self.sample_memory(name, e)
            why = None
            if inst["status"] == "Stopped":
                why = "runner_exited"  # also a launch that a crash left unstarted
            elif now - e["started"] > cfg["hard_timeout_seconds"]:
                why = "hard_timeout"
            else:
                names = runners(e["repo"])
                if names is not None:  # asked every pass, not remembered: a container that lost its JIT config stops counting
                    e["assigned"] = e["runner_name"] in names
                    if not e["assigned"] and now - e["started"] > cfg["unassigned_timeout_seconds"]:
                        if self.holds_job(name, e, jid):  # the list can miss a running job: look inside before letting go
                            e["assigned"] = True
                        else:
                            why = "unassigned"
            if why:
                self._delete(name, e, jid, why)
        # a launch whose container is gone (a crash between the record and the container, or a container removed by hand)
        for jid, e in self.state.jobs.items():
            if e["status"] in ("launching", "running") and e["container"] not in pool:
                self.jit_remove(e["repo"], e["runner_id"])
                e["status"], e["finished"] = "finished", now
                log("entry_closed", job=jid, container=e["container"], why="no container")

    def holds_job(self, name, entry, jid):
        """True unless the container is seen to run no Runner.Worker: a check that fails or times out holds the container
        too (unknown is never a reason to delete). Logs `assigned_by_worker` when a Worker is first seen in it, and
        `worker_check_failed` on each pass whose check fails."""
        try:
            n = self.lxc.workers(name, WORKER_CHECK_LIMIT, WORKER_CHECK_SECONDS)
        except PoolError as err:
            log("worker_check_failed", container=name, job=jid, error=str(err))
            return True
        if n:
            if not entry.get("by_worker"):
                entry["by_worker"] = True
                log("assigned_by_worker", container=name, job=jid, runner_name=entry.get("runner_name"), workers=n)
            return True
        return False

    def sample_memory(self, name, entry):
        """Keep the highest memory.peak and oom_kill read so far in the entry: a container that stopped has no cgroup left,
        so its deleted event reports the last pass's reading (a peak in the job's last pause can be missed)."""
        got = self.memory(name)
        for k in ("memory_peak_mib", "oom_kill"):
            v = got.get(k)
            if isinstance(v, int) and (entry.get(k) is None or v > entry[k]):
                entry[k] = v

    def _delete(self, name, entry, jid, why):
        if entry is not None:
            removed = self.jit_remove(entry["repo"], entry["runner_id"])
            if why == "unassigned" and not removed:
                # GitHub refuses to drop a runner that holds a job: it was assigned after all (or the listing lags)
                entry["assigned"] = True
                log("delete_skipped", container=name, job=jid, why="runner could not be unregistered")
                return
        if entry is not None:
            self.sample_memory(name, entry)  # a container still running (timeouts) gives its final reading here
            self.diag.keep(name, entry, jid, why)  # the runner's _diag logs would go with the container (I-121); never blocks
        try:
            self.lxc.delete(name)
        except PoolError as e:
            log("delete_failed", container=name, error=str(e))
            return
        if entry is not None:
            entry["status"] = "finished"
            entry["finished"] = self.clock()
        mem = {k: entry.get(k) if entry is not None else None for k in ("memory_peak_mib", "oom_kill")}
        log("deleted", container=name, job=jid, why=why, **mem)

    def count(self, pool, label):
        """Job containers of a label that exist (running, or stopped and not yet reaped); the spare never counts."""
        return sum(1 for n in pool if self.label_of(n)[0] == label and self.label_of(n)[1] != SPARE)

    def unassigned(self, pool, repo, label):
        """Live containers of this repository and label whose runner has not taken a job yet: each will take one queued job."""
        return sum(1 for e in self.state.jobs.values()
                   if e["status"] in ("launching", "running") and e["repo"] == repo and e["label"] == label
                   and e["container"] in pool and pool[e["container"]].get("status") != "Stopped" and not e.get("assigned"))

    def blocked(self, pool, label, jid, now):
        """Why a job id may not name a new container now: its container exists, its retry pause runs, or it ended a moment ago."""
        if self.cname(label, jid) in pool:
            return True
        e = self.state.jobs.get(jid)
        if e is None:
            return False
        if e["status"] in ("launching", "running"):
            return e["container"] in pool
        if e["status"] == "failed":
            return now < e.get("retry_after", 0)
        return now - e.get("finished", now) < self.cfg["lag_seconds"]

    def reserved_mib(self, pool, now):
        """Memory limits of the containers that started a moment ago (this pass included): MemAvailable does not show it yet."""
        total = 0
        for e in self.state.jobs.values():
            if e["status"] in ("launching", "running") and e["container"] in pool and now - e["started"] < YOUNG_SECONDS:
                total += mem_mib(self.cfg["labels"].get(e["label"], {}).get("memory")) or 0
        return total

    def launch(self, pool, now):
        refused = set()  # labels the admission rule refused in this pass: each is skipped for the rest of it, in every repository
        for repo in self.cfg["repos"]:
            try:
                jobs = self.queued(repo)
            except PoolError as e:
                log("source_failed", repo=repo, error=str(e))
                continue
            by_label = {}
            for job in jobs:
                label = next((l for l in job.get("labels", []) if l in self.cfg["labels"]), None)
                if label is not None:
                    by_label.setdefault(label, []).append(job)
            for label, wanted in by_label.items():
                if label in refused:
                    continue
                spec = self.cfg["labels"][label]
                need = len(wanted) - self.unassigned(pool, repo, label)
                for job in wanted:
                    if need <= 0:
                        break
                    jid = str(job["id"])
                    if self.blocked(pool, label, jid, now):
                        continue
                    if self.count(pool, label) >= spec["cap"]:
                        log("cap_reached", label=label, cap=spec["cap"], job=jid)
                        break
                    host = self.host()
                    if host["mem_available_mib"] is not None:
                        host = {**host, "mem_available_mib": host["mem_available_mib"] - self.reserved_mib(pool, now)}
                    why = admission_refusal(host, label_limits(self.cfg, label))
                    if why:
                        log("admission_refused", label=label, job=jid, why=why)
                        refused.add(label)  # only this label waits; another label's limits may still admit
                        break
                    if not self._start(repo, label, jid, spec, pool, now):
                        break  # a failure is likely to repeat for the next job of this label
                    pool[self.cname(label, jid)] = {"name": self.cname(label, jid), "status": "Running"}
                    need -= 1

    def _start(self, repo, label, jid, spec, pool, now):
        name = self.cname(label, jid)
        runner_name = f"ci-pool-{label}-{jid[-8:]}"
        try:
            runner_id, jit = self.jit_create(repo, label, runner_name)
        except PoolError as e:
            log("jit_failed", job=jid, error=str(e))
            return False
        # recorded before anything starts: a crash from here on leaves an entry that the next pass closes
        self.state.jobs[jid] = {"container": name, "repo": repo, "label": label, "runner_id": runner_id,
                                "runner_name": runner_name, "started": now, "status": "launching", "assigned": False}
        self.state.save()
        try:
            spare = self.cname(label, SPARE)
            if spare in pool and self._spare_is_current(label, pool[spare]):
                self.lxc.rename(spare, name)
                del pool[spare]
            else:
                if spare in pool:
                    self.lxc.delete(spare)
                    del pool[spare]
                self.lxc.init(name, spec["image"], spec["profile"], spec["memory"])
            self.lxc.push_secret(name, "/etc/ci-pool/jit", jit)
            self.lxc.start(name)
        except PoolError as e:
            log("launch_failed", job=jid, container=name, error=str(e))
            self.jit_remove(repo, runner_id)
            try:
                self.lxc.delete(name)
            except PoolError:
                pass
            self.state.jobs[jid].update(status="failed", retry_after=now + self.cfg["retry_seconds"])
            return False
        self.state.jobs[jid]["status"] = "running"
        self.state.save()
        log("launched", job=jid, container=name, repo=repo, label=label, runner=runner_name)
        return True

    def _spare_is_current(self, label, inst):
        want = self.lxc.image_fingerprint(self.cfg["labels"][label]["image"])
        return bool(want) and inst.get("base_image") == want and inst.get("status") == "Stopped"

    def keep_spares(self):
        """One stopped spare per label, made from the label's image; a spare of an older image is replaced."""
        pool = {i["name"]: i for i in self.lxc.list()}
        for label, spec in self.cfg["labels"].items():
            name = self.cname(label, SPARE)
            try:
                if name in pool and not self._spare_is_current(label, pool[name]):
                    if pool[name]["status"] != "Stopped":
                        continue
                    self.lxc.delete(name)
                    del pool[name]
                    log("spare_replaced", container=name)
                if name not in pool:
                    if not self.lxc.image_fingerprint(spec["image"]):
                        log("no_image", label=label, image=spec["image"])
                        continue
                    self.lxc.init(name, spec["image"], spec["profile"], spec["memory"])
                    log("spare_ready", container=name)
            except PoolError as e:
                log("spare_failed", container=name, error=str(e))

    def prune(self, now, pool):
        for jid, e in list(self.state.jobs.items()):
            if e["status"] == "finished":
                gone = now - e.get("finished", now) > 86400
            else:  # an entry that outlived the hard timeout with no container will never be reaped
                gone = now - e["started"] > self.cfg["hard_timeout_seconds"] and e["container"] not in pool
            if gone:
                del self.state.jobs[jid]


# ── profiles ─────────────────────────────────────────────────────────────────────────────────────────────────────
def parse_profile(text):
    """The subset of YAML that `lxc profile show` prints and the shipped profiles use: top-level keys, one level of
    mapping below `config:` and `devices:` (devices two), scalars as strings, lists ignored. Anything else is an error."""
    doc = {}
    stack = [(-1, doc)]
    block = None  # indent of a `|` or `>` scalar whose lines are skipped
    for n, raw in enumerate(text.splitlines(), 1):
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        if block is not None and indent > block:
            continue
        block = None
        line = raw.strip()
        if line.startswith("- "):
            continue  # used_by entries
        m = re.match(r"^([^:#]+?):(?:\s+(.*))?$", line)
        if not m:
            raise PoolError(f"line {n}: cannot read {line!r}")
        key, value = m.group(1).strip().strip("'\""), (m.group(2) or "").strip()
        while stack and indent <= stack[-1][0]:
            stack.pop()
        parent = stack[-1][1]
        if not isinstance(parent, dict):
            raise PoolError(f"line {n}: bad nesting")
        if value == "":
            parent[key] = {}
            stack.append((indent, parent[key]))
        elif value in ("|", ">", "|-", ">-"):
            parent[key] = value
            block = indent
        elif value in ("{}", "[]"):
            parent[key] = {} if value == "{}" else []
        else:
            parent[key] = value.strip("'\"")
    return doc


def profile_refusals(kind, text):
    """Every reason a pool profile of this kind (build|gate) is refused; [] when it is allowed."""
    try:
        doc = parse_profile(text)
    except PoolError as e:
        return [str(e)]
    out = []
    for k in doc:
        if k not in PROFILE_TOP_KEYS:
            out.append(f"top-level key {k} is not allowed")
    allowed = dict(COMMON_KEYS)
    if kind == "build":
        allowed.update(BUILD_KEYS)
    config = doc.get("config", {})
    if not isinstance(config, dict):
        return out + ["config is not a mapping"]
    for k, v in config.items():
        if k not in allowed:
            out.append(f"config key {k} is not allowed")
        elif allowed[k] is not None and v != allowed[k]:
            out.append(f"config {k} must be {allowed[k]}, is {v}")
    for k in REQUIRED_KEYS:
        if k not in config:
            out.append(f"config {k} is required")
    devices = doc.get("devices", {})
    if not isinstance(devices, dict):
        return out + ["devices is not a mapping"]
    for dname, dev in devices.items():
        want = DEVICES.get(dname)
        if want is None or not isinstance(dev, dict):
            out.append(f"device {dname} is not allowed")
            continue
        optional = DEVICE_OPTIONAL.get(dname, {})
        for k, v in dev.items():
            if k in optional:
                if v != optional[k]:
                    out.append(f"device {dname} {k} must be {optional[k]}, is {v}")
            elif k not in want:
                out.append(f"device {dname} key {k} is not allowed")
            elif want[k] is not None and v != want[k]:
                out.append(f"device {dname} {k} must be {want[k]}, is {v}")
        for k, v in want.items():
            if v is not None and k not in dev:
                out.append(f"device {dname} key {k} is required")
    for dname in DEVICES:
        if dname not in devices:
            out.append(f"device {dname} is required")
    return out


def check_profiles(cfg, lxc, files):
    """Exit status: 0 when every profile is allowed. Files are checked as given (kind from the name); with none, the live ones."""
    bad = 0
    targets = []
    if files:
        for f in files:
            with open(f) as fh:
                targets.append((f, "gate" if "gate" in os.path.basename(f) else "build", fh.read()))
    else:
        for label, spec in cfg["labels"].items():
            try:
                targets.append((spec["profile"], "gate" if label.endswith("gate") else "build", lxc.profile_show(spec["profile"])))
            except PoolError as e:
                print(f"{spec['profile']}: {e}", file=sys.stderr)
                bad += 1
    for name, kind, text in targets:
        reasons = profile_refusals(kind, text)
        for r in reasons:
            print(f"{name}: refused: {r}", file=sys.stderr)
        bad += bool(reasons)
        if not reasons:
            print(f"{name}: ok")
    return 1 if bad else 0


# ── entry point ──────────────────────────────────────────────────────────────────────────────────────────────────
def main(argv=None):
    ap = argparse.ArgumentParser(prog="ci-pool")
    ap.add_argument("command", choices=["run", "once", "check-profiles", "check-config"])
    ap.add_argument("--config", default=DEFAULT_CONFIG)
    ap.add_argument("--file", action="append", default=[])
    args = ap.parse_args(argv)
    if args.command == "check-config":
        # the config only: no lxc, no network; for whoever edits it before the service reads it
        try:
            load_config(args.config)
        except (PoolError, OSError, ValueError, TypeError, AttributeError) as e:
            print(f"ci-pool: {e}", file=sys.stderr)
            return 2
        return 0
    try:
        if args.command == "check-profiles" and args.file:
            return check_profiles(None, None, args.file)
        cfg = load_config(args.config)
        lxc = Lxc(cfg["lxc"], cfg["command_timeout_seconds"])
        if args.command == "check-profiles":
            return check_profiles(cfg, lxc, [])
        # a pool whose profiles are not the allowed ones starts nothing
        if check_profiles(cfg, lxc, []) != 0:
            log("profiles_refused")
            return 1
        stop = []  # set by SIGTERM in `run`; the diagnostic copy checks it between copies
        pool = Pool(cfg, lxc, State(cfg["state_file"]), stopping=lambda: bool(stop))
    except (PoolError, OSError, ValueError) as e:
        print(f"ci-pool: {e}", file=sys.stderr)
        return 1
    if args.command == "once":
        pool.tick()
        return 0
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))  # containers are left as they are
    log("started", repos=cfg["repos"], labels=sorted(cfg["labels"]), poll_seconds=pool.poll_seconds())
    while not stop:
        try:
            pool.tick()
        except Exception as e:  # one bad pass must not end the service
            log("tick_failed", error=f"{type(e).__name__}: {e}")
        for _ in range(pool.poll_seconds()):
            if stop:
                break
            time.sleep(1)
    log("stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
