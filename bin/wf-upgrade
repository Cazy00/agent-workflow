#!/usr/bin/env node
// Moves an adopted project to another workflow release and removes what the releases in between left behind
// (MAINT-0011). Reports by default; --apply writes. It never commits, pushes or approves. See adapters/upgrade.mjs.
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { applyUpgrade, planToChannel, planUpgrade, renderPlan, validateWith } from '../adapters/upgrade.mjs';

const USAGE = `usage: wf-upgrade --project DIR [--rev TAG] [--workflow-repo DIR] [--apply] [--json]
       wf-upgrade --project DIR --to-channel NAME --key ed25519:BASE64 [--key …] [--entry vX.Y.Z] [--workflow-repo DIR] [--apply] [--json]
  Moves the project's pin to TAG (default: this checkout's newest release tag) and cleans what the releases in between
  no longer need: config keys nothing reads, files they list, and the workflow files the scaffold installed, refreshed
  where the project has not changed them. It lists the steps each release leaves to you. Without --apply it only
  reports. It never commits or pushes: the result is a workflow change for a pull request.
  --to-channel (v2.19.0) is the second opt-in pull request: from a pin at v2.19.0 or later (move it first) or another
  channel, it writes workflow.channel (stable, canary, stable-N, canary-N) and workflow.channel_key (each --key, up to
  four) in place of the pin, moves milestones in progress and the profile to the channel, and replaces wf-ci.yml and
  wf-status.yml with the thin callers of the shared entry at --entry (default: the newest release tag at or above the
  pin) where the project has not changed them.
  On a project that follows a channel, the plain form refreshes the thin callers instead: each caller that is still a
  released caller template moves to the template of TAG (default: the newest release tag) and names TAG as its entry;
  a caller the project changed is left as it is and listed as a step by hand. The channel and its keys stay.`;
const fail = message => { console.error(`wf-upgrade: ${message}`); process.exit(2); };
const o = {};
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--apply' || a === '--json') o[a.slice(2)] = true;
  else if (a === '--key' && argv[i + 1] && !argv[i + 1].startsWith('--')) (o.keys ??= []).push(argv[++i]);
  else if (a === '--help' || a === '-h') { console.log(USAGE); process.exit(0); }
  else if (['--project', '--rev', '--workflow-repo', '--to-channel', '--entry'].includes(a) && argv[i + 1] && !argv[i + 1].startsWith('--')) o[a.slice(2)] = argv[++i];
  else fail(`invalid option or missing value: ${a}\n${USAGE}`);
}
if (!o.project) fail(`--project is required\n${USAGE}`);
if (o['to-channel'] && o.rev) fail('--to-channel and --rev are two different pull requests: give one');
if (!o['to-channel'] && (o.keys || o.entry)) fail('--key and --entry go with --to-channel');
const project = path.resolve(o.project);
const workflowRepo = path.resolve(o['workflow-repo'] ?? path.join(path.dirname(fileURLToPath(import.meta.url)), '..'));
try {
  const channel = o['to-channel'];
  const plan = channel ? planToChannel({ project, workflowRepo, channel, keys: o.keys, entry: o.entry }) : planUpgrade({ project, workflowRepo, rev: o.rev });
  let validation = null;
  // A channel's records are checked by the entry release's validator, which reads workflow.channel.
  if (o.apply && !plan.current) { applyUpgrade(plan); validation = validateWith({ workflowRepo, rev: plan.entry ? `refs/tags/${plan.entry}` : plan.to, project }); }
  if (o.json) console.log(JSON.stringify({ ...plan, changes: plan.changes.map(({ content, ...c }) => c), applied: Boolean(o.apply), validation }, null, 2));
  else process.stdout.write(renderPlan(plan, { applied: Boolean(o.apply), validation }));
  process.exit(validation && !validation.ok ? 1 : 0);
} catch (e) { fail(e.message); }
