#!/usr/bin/env bash
# ci-runner: GitHub Actions runners for agent-workflow projects, each in its own LXD container (MAINT-0017).
#   ci-runner init                     create the ci-build and ci-gate profiles; set only the keys they lack
#   ci-runner create NAME build|gate   a container: build = Docker and sudo for the runner (tests, deploys);
#                                      gate = no Docker, no sudo (the workflow's own jobs only)
#   ci-runner register OWNER/REPO NAME...   ask once for the repository's registration token (hidden), then register
#                                      a runner in each container under its role's label (wf-build, wf-gate), and start it
#   ci-runner status                   the containers and their runner services
set -euo pipefail
LXC=/snap/bin/lxc
SHARE=/usr/local/share/ci-runner
[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# profile NAME KEY=VALUE...: create the profile if it is missing, then set each default key it lacks. A half-made
# profile is repaired and a later release can add a key, but a value the host set (lxc profile set) is never changed.
profile() {
  local name="$1" kv value; shift
  $LXC profile show "$name" >/dev/null 2>&1 || $LXC profile create "$name"
  for kv in "$@"; do
    value="$($LXC profile get "$name" "${kv%%=*}")" # a failed read stops init (set -e) rather than overwrite the host's value
    [[ -n "$value" ]] || $LXC profile set "$name" "$kv"
  done
}

init() {
  profile ci-build security.nesting=true security.syscalls.intercept.mknod=true \
    security.syscalls.intercept.setxattr=true limits.cpu=4 limits.memory=6GiB boot.autostart=true
  profile ci-gate limits.cpu=1 limits.memory=1GiB boot.autostart=true
  $LXC profile list
}

create() {
  local name="$1" kind="$2"
  [[ "$name" =~ ^[a-z][a-z0-9-]*$ && ( "$kind" == build || "$kind" == gate ) ]] || usage
  if $LXC info "$name" >/dev/null 2>&1; then
    echo "$name already exists."
  else
    $LXC launch ubuntu:24.04 "$name" --profile default --profile "ci-$kind" \
      --config cloud-init.user-data="$(cat "$SHARE/ci-$kind.yaml")"
  fi
  echo "Waiting for $name's first-boot setup (a few minutes)…"
  $LXC exec "$name" -- cloud-init status --wait >/dev/null || true
  $LXC exec "$name" -- cloud-init status --long | sed -n '1,3p'
  $LXC file push "$SHARE/runner-setup" "$name/usr/local/sbin/runner-setup" --mode 0755
  $LXC exec "$name" -- git --version
  if [[ "$kind" == build ]]; then
    $LXC exec "$name" -- sudo -u runner -H docker info --format 'docker {{.ServerVersion}}, storage {{.Driver}}'
  fi
}

# role_label NAME: the label NAME's runner registers under, from its profile. The workflow files name these labels, so a
# variable (which any write collaborator can set) can only switch a runner on or off, never send a job to the other one.
role_label() {
  local config
  config="$($LXC config show "$1")"
  if grep -qx -- '- ci-gate' <<<"$config"; then echo wf-gate
  elif grep -qx -- '- ci-build' <<<"$config"; then echo wf-build
  else echo "ci-runner: $1 is neither a build nor a gate container" >&2; return 1
  fi
}

register() {
  local repo="$1" token pair name label; shift
  [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ && $# -ge 1 ]] || usage
  for pair in "$@"; do
    [[ "$pair" =~ ^[a-z][a-z0-9-]*(:[A-Za-z0-9_.-]+)?$ ]] || usage
    label="$(role_label "${pair%%:*}")"
    [[ "$pair" != *:* || "${pair#*:}" == "$label" ]] || { echo "ci-runner: the label ${pair#*:} does not match ${pair%%:*}'s role ($label)." >&2; exit 1; }
  done
  # Private repositories only: on a public one, a pull request from a fork could run code here. GitHub's API shows a
  # public repository to anyone and answers 404 for a private one asked without a token; anything else stops.
  local seen
  seen="$(curl -s -o /dev/null -w '%{http_code}' "https://api.github.com/repos/$repo")" || true
  [[ "$seen" == 404 ]] || { echo "$repo is public, or its visibility couldn't be checked (HTTP $seen): these runners are for private repositories only." >&2; exit 1; }
  read -rsp "Registration token for $repo (hidden, from Settings → Actions → Runners → New self-hosted runner): " token
  echo
  [[ "$token" =~ ^[A-Za-z0-9]+$ ]] || { echo "That doesn't look like a registration token." >&2; exit 1; }
  for pair in "$@"; do
    name="${pair%%:*}"
    label="$(role_label "$name")"
    echo "── $name ($label)"
    printf '%s\n' "$token" | $LXC exec "$name" -- /usr/local/sbin/runner-setup "$repo" "$label"
  done
}

status() {
  $LXC list --columns ns4
  local n
  for n in $($LXC list --format csv --columns n); do
    printf '%s: ' "$n"
    $LXC exec "$n" -- systemctl list-units --type=service --no-legend --plain 'actions.runner.*' 2>/dev/null \
      | awk '{print $1, $4}' | grep . || echo "no runner service"
  done
}

case "${1:-}" in
  init) [[ $# -eq 1 ]] || usage; init ;;
  create) [[ $# -eq 3 ]] || usage; create "$2" "$3" ;;
  register) [[ $# -ge 3 ]] || usage; shift; register "$@" ;;
  status) status ;;
  *) usage ;;
esac
