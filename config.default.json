{
  "workflow": {
    "repo": "Cazy00/agent-workflow",
    "version": "UNRELEASED",
    "revision": ""
  },
  "records_dir": "docs/workflow",
  "trusted_branch": "main",
  "acceptance_evidence": true,
  "planning_frontend": null,
  "approval": {
    "mechanism": "manual-signed-receipts",
    "label": "manual",
    "approver": "",
    "agent_identity": "",
    "derived_baselines": false
  },
  "paths": {
    "enforcement": [
      ".github/**",
      "CODEOWNERS",
      "docs/workflow/config.json",
      "scripts/wf",
      ".githooks/**",
      "validator/**",
      "bin/**",
      "adapters/**",
      ".agents/**",
      "procedures/**",
      "config.default.json",
      "**/CODEOWNERS",
      ".claude/agents/**"
    ],
    "production": [
      "src/**",
      "prisma/**",
      "scripts/**",
      "public/**",
      "package.json",
      "package-lock.json",
      "tsconfig*.json",
      "next.config.*",
      "*.config.*",
      ".env*",
      "Dockerfile",
      "**/*.{sh,sql,ts,tsx,js,mjs,cjs,py,ps1}",
      "tests/**",
      "test/**",
      "infra/**",
      "infrastructure/**",
      "migrations/**",
      "**/Dockerfile*",
      "**/Makefile",
      "**/*.{go,rs,java,kt,swift,c,cpp,h,rb,php,tf,tfvars,wasm}"
    ],
    "generated": [],
    "acceptance_tests": [
      "tests/acceptance-map.json",
      "tests/acceptance/**"
    ],
    "governing": [
      "docs/workflow/profile.md",
      "docs/workflow/decisions/**",
      "docs/specs/**",
      "docs/contracts/**",
      "AGENTS.md",
      "CLAUDE.md",
      "docs/workflow/milestones/**",
      "docs/workflow/acceptance.json"
    ],
    "planning": [
      "docs/workflow/tasks/**",
      "docs/workflow/feedback/**",
      "docs/workflow/checkpoints/**",
      "docs/**",
      "README.md",
      "LICENSE",
      ".gitignore",
      "evidence/**"
    ]
  },
  "roles": {
    "lead": { "model": "sonnet", "effort": "low" },
    "implementer": { "model": null, "effort": { "light": "medium", "standard": "high", "deep": "xhigh" } },
    "paperwork": { "model": "haiku", "effort": "low" },
    "walker": { "model": "sonnet", "effort": "medium" },
    "acceptance": { "model": "sonnet", "effort": "medium" }
  },
  "repository": ""
}
