#!/usr/bin/env bash
# Local convenience entry point. Trusted CI must invoke an owner-installed copy outside
# the candidate checkout, with these settings supplied by its protected environment.
set -euo pipefail
: "${WF_VALIDATOR_REPO:?set WF_VALIDATOR_REPO to the owner-provisioned workflow Git checkout}"
: "${WF_VALIDATOR_REV:?set WF_VALIDATOR_REV to its approved full commit hash}"
[[ "$WF_VALIDATOR_REV" =~ ^[0-9a-f]{40}$|^[0-9a-f]{64}$ ]] || { echo 'wf: validator revision must be an immutable full hash' >&2; exit 2; }
[ -z "${WF_LOCAL:-}" ] || { echo 'wf: WF_LOCAL is not an enforcement override' >&2; exit 2; }
# The directory holding the `.git` entry at or above the current one (the current directory outside Git);
# `rev-parse --show-toplevel` would follow a clone's core.worktree.
WF_PROJECT_ROOT="$(pwd)"
WF_DIR="$WF_PROJECT_ROOT"
while [ "$WF_DIR" != "/" ]; do
  if [ -e "$WF_DIR/.git" ]; then WF_PROJECT_ROOT="$WF_DIR"; break; fi
  WF_DIR="$(dirname "$WF_DIR")"
done
WF_PINNED_REV="$(git -C "$WF_VALIDATOR_REPO" rev-parse --verify "$WF_VALIDATOR_REV^{commit}")"
[ "$WF_PINNED_REV" = "$WF_VALIDATOR_REV" ] || exit 2
WF_EXTRACT="$(mktemp -d)"
trap 'rm -rf "$WF_EXTRACT"' EXIT
# Execute the committed blob, never a writable cache's working tree or candidate pin.
git -C "$WF_VALIDATOR_REPO" archive "$WF_VALIDATOR_REV" validator | tar -x -C "$WF_EXTRACT"
# Supply a default only when the caller did not choose a repository. Forward
# explicit options unchanged so the CLI still rejects duplicates/missing values.
WF_HAS_REPO=false
for WF_ARG in "$@"; do
  if [ "$WF_ARG" = '--repo' ]; then WF_HAS_REPO=true; fi
done
if [ "$WF_HAS_REPO" = true ]; then
  node "$WF_EXTRACT/validator/cli.js" "$@"
else
  node "$WF_EXTRACT/validator/cli.js" --repo "$WF_PROJECT_ROOT" "$@"
fi
