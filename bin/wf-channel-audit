#!/usr/bin/env node
// After a bad release on a channel: the merged pull requests each project's gate judged at that revision, from their
// `wf resolved` check runs (contract channel-audit v1, adapters/audit.mjs). Read-only: it only reads GitHub through
// `gh api`. Exit statuses: 0 listed (a project that could not be read is named in the output and gives 1), 2 bad usage.
import { spawnSync } from 'node:child_process';
import { audit, render, AuditError } from '../adapters/audit.mjs';

const USAGE = `usage: wf-channel-audit --revision HASH --repo OWNER/NAME [--repo …] [--since DATE] [--json]
  Lists, per project repository, the merged pull requests whose head has a wf resolved check run (written by the shared
  gate, GitHub Actions only) naming the revision (a full hash or a prefix of 7 or more), for the owner to recheck.
  --since keeps pull requests merged at or after DATE. Reads with gh api and its login.`;
const fail = message => { console.error(`wf-channel-audit: ${message}`); process.exit(2); };
const o = { repos: [] };
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--help' || a === '-h') { console.log(USAGE); process.exit(0); }
  else if (a === '--json') o.json = true;
  else if (a === '--repo' && argv[i + 1] && !argv[i + 1].startsWith('--')) o.repos.push(argv[++i]);
  else if (['--revision', '--since'].includes(a) && argv[i + 1] && !argv[i + 1].startsWith('--')) o[a.slice(2)] = argv[++i];
  else fail(`invalid option or missing value: ${a}\n${USAGE}`);
}
if (!o.revision) fail(`--revision is required\n${USAGE}`);
const api = async route => {
  const r = spawnSync('gh', ['api', '--method', 'GET', route], { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, timeout: 60000 });
  if (r.error || r.status !== 0) throw new Error(`gh api ${route.split('?')[0]}: ${(r.error?.message ?? r.stderr).trim().split('\n').pop()}`);
  return JSON.parse(r.stdout);
};
try {
  const result = await audit({ revision: o.revision, repos: o.repos, since: o.since, api });
  process.stdout.write(o.json ? `${JSON.stringify(result, null, 2)}\n` : render(result));
  process.exit(result.projects.some(p => p.error) ? 1 : 0);
} catch (e) { if (e instanceof AuditError) fail(e.message); throw e; }
