#!/usr/bin/env node
// The body of the shared gate (v2.19.0): what the copied wf-ci.yml's "Run the gate" step did, moved into the repository so
// it is versioned with the validator and travels with the channel. The reusable entry (.github/workflows/wf-gate.yml)
// runs it from the RESOLVED revision (bin/wf-resolve over the base branch's config), never from the candidate, and it
// runs this checkout's own validator (../validator/cli.js). It also checks the head's caller names the entry at a release
// tag this release accepts. Exit status: the gate's (0 pass, 1 fail; a draft always 0), 2 bad usage or a refused caller.
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

// The oldest entry (the tag a project's caller names in `uses: …/wf-gate.yml@vX.Y.Z`) this release accepts. The entry's
// contract (its inputs and the fields it records) changes only on a major release, so this rises only then.
export const OLDEST_ENTRY = 'v2.19.0';
export const CALLER = '.github/workflows/wf-ci.yml';
const ENTRY_PATH = '.github/workflows/wf-gate.yml';

const USAGE = `usage: wf-gate-ci --repo DIR --base SHA --candidate SHA --resolved FILE [--pull-request --branch REF --description FILE [--draft]] [--entry-repo OWNER/REPO]
  The shared gate, run by the reusable entry from the resolved revision. --resolved is bin/wf-resolve's output with
  resolved_at. With --pull-request it first checks the head's ${CALLER} names the entry (--entry-repo, default the base
  config's workflow.repo) at a vX.Y.Z tag no older than ${OLDEST_ENTRY}, then runs wf ci (enforced and owner-merge modes)
  or wf records (manual mode); without it (a push, schedule or dispatch run on the trusted branch) it runs wf records at
  the candidate. Writes the verdict to GITHUB_STEP_SUMMARY when set; WF_PR_AUTO_MERGE passes through to wf ci.`;

const here = path.dirname(fileURLToPath(import.meta.url));
const cliPath = path.join(here, '..', 'validator', 'cli.js');
const fail = (message, status = 2) => { console.error(`wf-gate-ci: ${message}`); process.exit(status); };
const summary = lines => { if (process.env.GITHUB_STEP_SUMMARY) fs.appendFileSync(process.env.GITHUB_STEP_SUMMARY, lines.join('\n') + '\n'); };

const parseVersion = v => (String(v ?? '').match(/^v(\d+)\.(\d+)\.(\d+)$/) ?? []).slice(1).map(Number);
const older = (a, b) => { const [x, y] = [parseVersion(a), parseVersion(b)]; for (let i = 0; i < 3; i++) if (x[i] !== y[i]) return x[i] < y[i]; return false; };

// The head caller's `uses:` line -> null when it names the entry at an accepted tag, else the reason.
export function callerProblem(text, entryRepo) {
  if (text == null) return `${CALLER} is missing at the head: a channel project calls the shared entry from it`;
  const uses = [...text.matchAll(/^\s*uses:\s*['"]?([^'"\s#]+)['"]?\s*(?:#.*)?$/gm)].map(m => m[1]).filter(u => u.includes(ENTRY_PATH));
  if (uses.length !== 1) return `${CALLER} must call ${entryRepo}/${ENTRY_PATH} exactly once (found ${uses.length})`;
  const [target, ref] = uses[0].split('@');
  if (target.toLowerCase() !== `${entryRepo}/${ENTRY_PATH}`.toLowerCase()) return `${CALLER} calls ${target}, not ${entryRepo}/${ENTRY_PATH}`;
  if (parseVersion(ref).length !== 3) return `${CALLER} names the entry at ${ref ?? 'no ref'}: name a release tag vX.Y.Z, which the tag ruleset keeps immutable`;
  const entry = text.match(/^\s*entry:\s*['"]?([^'"\s#]+)/m)?.[1];
  if (entry !== ref) return `${CALLER} must repeat the entry's tag as \`with: entry: ${ref}\` (found ${entry ?? 'none'}): the entry reads its resolver from that tag`;
  if (older(ref, OLDEST_ENTRY)) return `${CALLER} names the entry at ${ref}, older than ${OLDEST_ENTRY}, the oldest entry this release accepts: move it to ${OLDEST_ENTRY} or later`;
  return null;
}

// "Judged by agent-workflow v2.19.0 (abc123def456), channel stable, resolved at <time>."
export function judgedBy(resolved) {
  const version = resolved.version ?? resolved.declared_version ?? '';
  const channel = resolved.channel === 'hold' ? 'a hold (the base branch’s pin)' : `channel ${resolved.channel}`;
  return `Judged by agent-workflow ${version} (${String(resolved.revision ?? '').slice(0, 12)}), ${channel}, resolved at ${resolved.resolved_at ?? 'an unknown time'}.`;
}

function main(argv) {
  const o = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--help' || a === '-h') { console.log(USAGE); process.exit(0); }
    else if (a === '--pull-request' || a === '--draft') o[a.slice(2)] = true;
    else if (['--repo', '--base', '--candidate', '--resolved', '--branch', '--description', '--entry-repo'].includes(a) && argv[i + 1] !== undefined && !argv[i + 1].startsWith('--')) o[a.slice(2)] = argv[++i];
    else fail(`invalid option or missing value: ${a}\n${USAGE}`);
  }
  for (const k of ['repo', 'base', 'candidate', 'resolved']) if (!o[k]) fail(`--${k} is required\n${USAGE}`);
  if (o['pull-request'] && (!o.branch || !o.description)) fail(`--pull-request needs --branch and --description\n${USAGE}`);
  if (o.draft && !o['pull-request']) fail('--draft goes with --pull-request');
  const repo = path.resolve(o.repo);
  let resolved;
  try { resolved = JSON.parse(fs.readFileSync(o.resolved, 'utf8')); } catch (e) { fail(`cannot read the resolution ${o.resolved}: ${e.message}`); }
  if (!resolved || typeof resolved.channel !== 'string' || typeof resolved.revision !== 'string') fail(`${o.resolved} is not a resolution: it needs channel and revision`);
  const git = args => spawnSync('git', ['-C', repo, ...args], { encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 });
  const shown = git(['show', `${o.base}:docs/workflow/config.json`]);
  if (shown.status !== 0) fail(`cannot read docs/workflow/config.json at the base ${o.base}: ${shown.stderr.trim()}`);
  let baseConfig;
  try { baseConfig = JSON.parse(shown.stdout); } catch { fail('the base config is not valid JSON'); }
  const label = baseConfig.approval?.label ?? 'manual';
  const draft = Boolean(o.draft);
  const wf = (args, opts = {}) => spawnSync(process.execPath, [cliPath, '--repo', repo, ...args], { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, ...opts });
  const judged = judgedBy(resolved);

  if (o['pull-request']) {
    const head = git(['show', `${o.candidate}:${CALLER}`]);
    const problem = callerProblem(head.status === 0 ? head.stdout : null, o['entry-repo'] ?? baseConfig.workflow?.repo ?? 'Cazy00/agent-workflow');
    if (problem) {
      summary([`### wf ci${draft ? ' (draft)' : ''}: fail`, `- ${problem}`, judged]);
      console.error(`wf-gate-ci: ${problem}`);
      process.exit(draft ? 0 : 2);
    }
  }

  // A trusted-branch run (push, schedule, dispatch) or manual mode: the records at the candidate.
  if (!o['pull-request'] || label === 'manual') {
    const why = o['pull-request'] ? 'manual mode: checking the records; the owner’s receipts are checked by wf closeout' : 'a trusted-branch run: checking the records at its head';
    console.log(why);
    const r = wf(['records', '--candidate', o.candidate], { stdio: 'inherit' });
    const code = r.status ?? 1;
    if (draft) { summary([`### wf ci (draft): records check exit ${code}. A draft run never fails; mark the pull request ready to run the gate.`, judged]); process.exit(0); }
    summary([`### ${o['pull-request'] ? 'wf ci' : 'wf records'}: ${code === 0 ? 'pass' : 'fail'}`, judged]);
    process.exit(code);
  }

  // Enforced and owner-merge modes: the integration gate. The task comes from the branch name, the delivery evidence from
  // the description's marked block (procedures/execute.md *Checkpoints and task records*).
  const r = wf(['ci', '--baseline', o.base, '--candidate', o.candidate, '--branch', o.branch, '--delivery-evidence', o.description]);
  process.stderr.write(r.stderr ?? '');
  const code = r.status ?? 1;
  let result = null;
  try { result = JSON.parse(r.stdout); } catch { /* reported below */ }
  if (!result) {
    process.stdout.write(r.stdout ?? '');
    summary(['### wf ci could not run', 'Its reason is in the log.', judged]);
    process.exit(draft ? 0 : code || 1);
  }
  // wf ci's JSON carries what judged it: the resolved channel, revision and version, and when it was resolved.
  result.workflow = { channel: resolved.channel, revision: resolved.revision, version: resolved.version ?? resolved.declared_version ?? null, resolved_at: resolved.resolved_at ?? null };
  console.log(JSON.stringify(result, null, 2));
  const fails = result.verdict === 'fail' ? (result.findings ?? []).filter(f => !/^(?:(?:planning|production|governing|enforcement|generated|unclassified): |unverified: |note: |notice: )/.test(f)) : [];
  const lines = [`### wf ci${draft ? ' (draft)' : ''}: ${result.verdict}`, ...fails.map(f => `- ${f.trim()}`)];
  if (draft) lines.push('**Draft:** this run is information only and never fails. `gh pr ready` runs the gate that counts.');
  if (result.lane) lines.push(`**Lane:** ${result.lane}.`);
  if (result.records_only) lines.push('**Records only:** a project’s own CI may skip its product jobs (procedures/delivery.md).');
  if (result.merge === 'agent') lines.push('**Merge:** the agent may merge this once every required check has passed.');
  if (result.merge === 'owner') {
    lines.push('**Merge:** the owner.', ...(result.owner_reasons ?? []).map(x => `- ${x}`));
    console.log(`::notice title=The owner merges this::${(result.owner_reasons ?? []).join('; ').replace(/[\r\n%]/g, ' ')}`);
  }
  if (result.notices?.length) {
    lines.push('**For the owner’s notice** (checkpoint notice: the agent merges):', ...result.notices.map(x => `- notice: ${x}`));
    console.log(`::notice title=For the owner's notice::${result.notices.join('; ').replace(/[\r\n%]/g, ' ')}`);
  }
  if (result.deferred?.length) lines.push('**For the owner at the milestone’s acceptance:**', ...result.deferred.map(x => `- ${x}`));
  lines.push(judged);
  summary(lines);
  process.exit(draft ? 0 : code);
}

if (process.argv[1] && fs.realpathSync(process.argv[1]) === fileURLToPath(import.meta.url)) main(process.argv.slice(2));
