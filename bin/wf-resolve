#!/usr/bin/env node
// Resolves a project's workflow channel (or hold) to the release that judges its runs: contract channel-resolve v2,
// adapters/resolve.mjs. A channel is a marker on a GitHub release (stable: marked latest; canary: newest published), never
// a moved ref. Read-only. It prints {channel, revision, version} as JSON, or refuses with the reason on stderr and exit
// status 2; it never falls back to main or to a cache. Exit statuses: 0 resolved, 2 refused or bad usage, 3 an unexpected
// error (a bug, not a decision: callers must not read it as a refusal).
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { resolve, pickToken, ResolveError } from '../adapters/resolve.mjs';

const USAGE = `usage: wf-resolve (--config FILE | --project DIR [--base REV]) [--release-identity LOGIN] [--git-url URL] [--api-url URL]
  Reads the workflow section of the BASE branch's docs/workflow/config.json: FILE is a copy of it, or --project DIR with
  --base REV (default HEAD) reads it from that commit with git. A hold (workflow.revision) is returned as it stands. A
  channel (workflow.channel) is stable or canary (major 2), or stable-N / canary-N: stable is the GitHub release marked
  latest, canary the newest release that is neither a draft nor a prerelease, both within the channel's major. It
  resolves only if that release was made by the release identity (--release-identity, or WF_RELEASE_IDENTITY), an active
  tag ruleset forbids updating, deleting and force-pushing v* tags, and the tag's commit is on main with that version in
  its package.json. Exit status: 0 resolved, 2 refused or bad usage, 3 unexpected error. --api-url replaces GitHub's API
  (tests); --git-url replaces the repository fetched for main's ancestry and the commit (a mirror, tests), never the
  release, tag or ruleset. Output: {channel, revision, version}.`;
const fail = (message, status = 2) => { console.error(`wf-resolve: ${message}`); process.exit(status); };
const o = {};
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--help' || a === '-h') { console.log(USAGE); process.exit(0); }
  else if (['--config', '--project', '--base', '--release-identity', '--git-url', '--api-url'].includes(a) && argv[i + 1] && !argv[i + 1].startsWith('--')) o[a.slice(2)] = argv[++i];
  else fail(`invalid option or missing value: ${a}\n${USAGE}`);
}
if (Boolean(o.config) === Boolean(o.project)) fail(`give exactly one of --config and --project\n${USAGE}`);
if (o.base && !o.project) fail(`--base goes with --project\n${USAGE}`);
let text;
if (o.config) {
  try { text = fs.readFileSync(path.resolve(o.config), 'utf8'); } catch (e) { fail(`cannot read ${o.config}: ${e.message}`); }
} else {
  if ((o.base ?? '').startsWith('-')) fail(`--base ${o.base} is not a revision`);
  const r = spawnSync('git', ['-C', path.resolve(o.project), 'show', '--end-of-options', `${o.base ?? 'HEAD'}:docs/workflow/config.json`], { encoding: 'utf8' });
  if (r.status !== 0) fail(`cannot read docs/workflow/config.json at ${o.base ?? 'HEAD'}: ${(r.stderr || r.error?.message || '').trim()}`);
  text = r.stdout;
}
let config;
try { config = JSON.parse(text); } catch { fail('the base config is not valid JSON'); }
try {
  const out = await resolve({
    config,
    releaseIdentity: o['release-identity'] ?? process.env.WF_RELEASE_IDENTITY ?? '',
    gitUrl: o['git-url'],
    api: o['api-url'] ?? undefined,
    token: pickToken()
  });
  console.log(JSON.stringify(out));
} catch (e) { e instanceof ResolveError ? fail(e.message) : fail(`unexpected: ${e.stack ?? e.message}`, 3); }
